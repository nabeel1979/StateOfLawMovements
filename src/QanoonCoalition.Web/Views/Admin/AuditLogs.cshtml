@using QanoonCoalition.Web.Models
@model List<AuditLog>
@{
    ViewData["Title"] = "سجل العمليات";
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-history"></i> سجل العمليات</h1>
    <span class="text-muted">الإجمالي: @ViewBag.Total عملية</span>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>العملية</th>
                    <th>المستخدم</th>
                    <th>الحركة</th>
                    <th>الكيان</th>
                    <th>الوصف</th>
                    <th>عنوان IP</th>
                    <th>التاريخ والوقت</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>
                            <span class="badge" style="background:var(--primary-soft);color:var(--primary-dark);font-size:.75rem">
                                @log.Action
                            </span>
                        </td>
                        <td style="font-size:.85rem">@(log.User?.FullName ?? "—")</td>
                        <td style="font-size:.82rem">@(log.Movement?.Name ?? "—")</td>
                        <td style="font-size:.8rem">
                            @(log.EntityType ?? "—")
                            @if (log.EntityId != null) { <small class="text-muted">#@log.EntityId</small> }
                        </td>
                        <td style="font-size:.82rem">@(log.Description ?? "—")</td>
                        <td style="font-size:.78rem;font-family:monospace">@(log.IpAddress ?? "—")</td>
                        <td style="font-size:.78rem">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-history"></i>
                <p>لا توجد عمليات مسجلة.</p>
            </div>
        }
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="AuditLogs" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
