@using QanoonCoalition.Web.Models
@{
    ViewData["Title"] = "إضافة مسؤول";
    var movement = (Movement)ViewBag.Movement;
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-user-plus"></i> إضافة مسؤول لحركة: @movement.Name</h1>
    <a asp-action="MovementManagers" asp-route-movementId="@movement.Id" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right me-1"></i> العودة
    </a>
</div>

<div class="card" style="max-width:560px">
    <div class="card-header"><i class="fas fa-user-shield"></i> بيانات المسؤول</div>
    <div class="card-body p-4">
        <form method="post" asp-action="CreateManager" asp-route-movementId="@movement.Id">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    { <div>@e.ErrorMessage</div> }
                </div>
            }
            <div class="mb-3">
                <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                <input type="text" name="fullName" class="form-control" required maxlength="200"/>
            </div>
            <div class="mb-3">
                <label class="form-label">الصفة الوظيفية</label>
                <select name="title" class="form-select">
                    <option value="">— اختر الصفة —</option>
                    @foreach (var t in (List<string>)(ViewBag.ManagerTitles ?? new List<string>()))
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                <input type="email" name="email" class="form-control" required maxlength="200"/>
            </div>
            <div class="mb-4">
                <label class="form-label">كلمة المرور المؤقتة <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="text" name="password" id="genPass" class="form-control" required
                           readonly placeholder="اضغط على زر التوليد..." dir="ltr"
                           style="background:#f8f9fa;font-family:monospace;letter-spacing:.05em"/>
                    <button type="button" class="btn btn-success" onclick="generatePass()" title="توليد كلمة مرور تلقائية">
                        <i class="fas fa-sync-alt me-1"></i> توليد
                    </button>
                </div>
                <div class="form-text text-warning">
                    <i class="fas fa-info-circle me-1"></i>
                    سيُطلب من المسؤول تغيير هذه الكلمة عند أول دخول
                </div>
            </div>
            <button type="submit" class="btn btn-primary px-5" id="submitBtn" disabled>
                <i class="fas fa-save me-2"></i> إضافة المسؤول
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
function generatePass() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789@@#$%!';
    let pass = '';
    for (let i = 0; i < 10; i++)
        pass += chars[Math.floor(Math.random() * chars.length)];
    document.getElementById('genPass').value = pass;
    document.getElementById('submitBtn').disabled = false;
}
// توليد تلقائي عند فتح الصفحة
window.addEventListener('DOMContentLoaded', generatePass);
</script>
}
