@{
    ViewData["Title"] = "إضافة مستخدم جديد";
}

<div class="page-header mb-4">
    <h4 class="mb-1"><i class="fas fa-user-plus me-2" style="color:var(--primary)"></i> إضافة مستخدم جديد</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Users">مستخدمو النظام</a></li>
            <li class="breadcrumb-item active">إضافة</li>
        </ol>
    </nav>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div><i class="fas fa-exclamation-circle me-1"></i>@e.ErrorMessage</div> }
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <form method="post" asp-action="CreateUser">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" required placeholder="الاسم الرباعي"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" required
                               placeholder="example@domain.com" dir="ltr"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">كلمة المرور المؤقتة <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" name="password" id="genPass" class="form-control" required
                                   readonly dir="ltr" style="background:#f8f9fa;font-family:monospace"
                                   placeholder="اضغط على توليد..."/>
                            <button type="button" class="btn btn-success" onclick="generatePass()">
                                <i class="fas fa-sync-alt me-1"></i> توليد
                            </button>
                        </div>
                        <div class="form-text text-warning">
                            <i class="fas fa-info-circle me-1"></i>
                            سيُطلب من المستخدم تغيير هذه الكلمة عند أول دخول
                        </div>
                    </div>

                    <div class="mb-4 p-3 rounded" style="background:#f0faf4;border:1px solid #c3e6cb;">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:38px;height:38px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1rem;flex-shrink:0">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div>
                                <div style="font-size:.75rem;color:#6c757d;margin-bottom:2px">أُضيف بواسطة</div>
                                <div style="font-weight:700;color:var(--primary);font-size:.95rem">@User.Identity!.Name</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" id="submitBtn" class="btn btn-primary px-5" disabled>
                            <i class="fas fa-save me-2"></i> إضافة المستخدم
                        </button>
                        <a asp-action="Users" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function generatePass() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789@@#$%!';
    let pass = '';
    for (let i = 0; i < 10; i++)
        pass += chars[Math.floor(Math.random() * chars.length)];
    document.getElementById('genPass').value = pass;
    document.getElementById('submitBtn').disabled = false;
}
window.addEventListener('DOMContentLoaded', generatePass);
</script>
}
