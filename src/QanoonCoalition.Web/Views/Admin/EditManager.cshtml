@using QanoonCoalition.Web.Models
@model User
@{
    ViewData["Title"] = "تعديل مسؤول";
    var movement = (Movement)ViewBag.Movement;
    var titles = (List<string>)(ViewBag.ManagerTitles ?? new List<string>());
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-user-edit"></i> تعديل مسؤول: @Model.FullName</h1>
    <a asp-action="MovementManagers" asp-route-movementId="@movement.Id" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right me-1"></i> العودة
    </a>
</div>

<div class="card" style="max-width:580px">
    <div class="card-header"><i class="fas fa-user-shield me-1"></i> بيانات المسؤول — @movement.Name</div>
    <div class="card-body p-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
        }

        <form method="post" asp-action="EditManager" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()

            <!-- الاسم -->
            <div class="mb-3">
                <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                <input type="text" name="fullName" class="form-control"
                       value="@Model.FullName" required maxlength="200"/>
            </div>

            <!-- الصفة -->
            <div class="mb-3">
                <label class="form-label">الصفة الوظيفية</label>
                <select name="title" class="form-select">
                    <option value="">— بدون صفة —</option>
                    @foreach (var t in titles)
                    {
                        <option value="@t" selected="@(Model.Title == t)">@t</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(Model.Title) && !titles.Contains(Model.Title))
                {
                    <div class="form-text text-muted">الصفة الحالية: @Model.Title</div>
                }
            </div>

            <!-- البريد (للعرض فقط) -->
            <div class="mb-3">
                <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                <input type="email" name="email" class="form-control" value="@Model.Email" required dir="ltr"/>
            </div>

            <!-- إعادة توليد كلمة المرور -->
            <div class="mb-3">
                <label class="form-label">إعادة تعيين كلمة المرور <small class="text-muted">(اتركها فارغة إن لم تريد تغييرها)</small></label>
                <div class="input-group">
                    <input type="text" name="newPassword" id="genPass" class="form-control" readonly
                           minlength="8" dir="ltr"
                           style="background:#f8f9fa;font-family:monospace"
                           placeholder="اضغط على توليد لإعادة تعيين..."/>
                    <button type="button" class="btn btn-outline-warning" onclick="generatePass()" title="توليد كلمة مرور جديدة">
                        <i class="fas fa-sync-alt me-1"></i> توليد
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="clearPass()" title="إلغاء التغيير">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="form-text text-warning" id="passHint" style="display:none">
                    <i class="fas fa-info-circle me-1"></i>
                    سيُطلب من المسؤول تغيير هذه الكلمة عند أول دخول
                </div>
            </div>

            <!-- الحالة -->
            <div class="mb-4">
                <label class="form-label">الحالة</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isActive"
                           value="true" @(Model.IsActive ? "checked" : "") id="isActiveSwitch"/>
                    <label class="form-check-label" for="isActiveSwitch">
                        @(Model.IsActive ? "نشط" : "معطل")
                    </label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-5">
                    <i class="fas fa-save me-2"></i> حفظ التعديلات
                </button>
                <a asp-action="MovementManagers" asp-route-movementId="@movement.Id"
                   class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelector('[name="isActive"][type="checkbox"]').addEventListener('change', function() {
    this.nextElementSibling.textContent = this.checked ? 'نشط' : 'معطل';
});
function generatePass() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789@@#$%!';
    let pass = '';
    for (let i = 0; i < 10; i++)
        pass += chars[Math.floor(Math.random() * chars.length)];
    document.getElementById('genPass').value = pass;
    document.getElementById('passHint').style.display = '';
}
function clearPass() {
    document.getElementById('genPass').value = '';
    document.getElementById('passHint').style.display = 'none';
}
</script>
