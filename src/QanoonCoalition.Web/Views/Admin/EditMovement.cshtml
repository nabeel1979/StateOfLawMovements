@using QanoonCoalition.Web.Models
@model Movement
@{
    ViewData["Title"] = "تعديل الحركة";
}
@{
    var govs = (List<string>)(ViewBag.Provinces ?? new List<string>());
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-edit"></i> تعديل: @Model.Name</h1>
    <a asp-action="MovementDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right me-1"></i> العودة
    </a>
</div>

<div class="card" style="max-width:760px">
    <div class="card-header"><i class="fas fa-sitemap"></i> بيانات الحركة</div>
    <div class="card-body p-4">
        <form method="post" asp-action="EditMovement" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    { <div>@e.ErrorMessage</div> }
                </div>
            }
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">اسم الحركة <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" value="@Model.Name" required maxlength="200"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">رقم الهاتف</label>
                    <input type="tel" name="phone" class="form-control" value="@Model.Phone" maxlength="20"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="email" class="form-control" value="@Model.Email" maxlength="200"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">المحافظة</label>
                    <select name="governorate" class="form-select">
                        <option value="">— اختر المحافظة —</option>
                        @foreach (var g in govs)
                        {
                            <option value="@g" selected="@(Model.Governorate == g)">@g</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">العنوان التفصيلي</label>
                    <input type="text" name="address" class="form-control" value="@Model.Address" maxlength="500"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الموقع الإلكتروني</label>
                    <input type="url" name="website" class="form-control" value="@Model.Website" maxlength="200"/>
                </div>
                <div class="col-12">
                    <label class="form-label">الوصف</label>
                    <textarea name="description" class="form-control" rows="4" maxlength="2000">@Model.Description</textarea>
                </div>
                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="fas fa-save me-2"></i> حفظ التعديلات
                    </button>
                    <a asp-action="MovementDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">إلغاء</a>
                </div>
            </div>
        </form>
    </div>
</div>
