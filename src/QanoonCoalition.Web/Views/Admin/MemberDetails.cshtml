@using QanoonCoalition.Web.Models
@model Member
@{
    ViewData["Title"] = "تفاصيل العضو";
    string genderText = Model.Gender == Gender.Male ? "ذكر" : Model.Gender == Gender.Female ? "أنثى" : "—";
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-id-card"></i> تفاصيل العضو</h1>
    <div class="d-flex gap-2">
        <a href="@Url.Action("PrintMember", "Admin", new { id = Model.Id })" target="_blank"
           class="btn btn-outline-secondary">
            <i class="fas fa-print me-1"></i> طباعة
        </a>
        <a asp-action="Members" class="btn btn-outline-primary">
            <i class="fas fa-arrow-right me-1"></i> العودة
        </a>
    </div>
</div>

<!-- شريط الرقم التسلسلي -->
<div class="card mb-4" style="border-right: 5px solid var(--primary)">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div>
            <div class="text-muted" style="font-size:.8rem">الرقم التسلسلي</div>
            <div style="font-size:1.6rem; font-weight:800; color:var(--primary); letter-spacing:3px">
                @Model.SerialNumber
            </div>
        </div>
        <div class="text-muted" style="text-align:left; font-size:.82rem">
            <div>الحركة: <strong>@Model.Movement.Name</strong></div>
            <div>تاريخ الانضمام: <strong>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
        </div>
    </div>
</div>

<!-- تابات البيانات -->
<ul class="nav nav-tabs mb-3" id="memberTabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#personal">
            <i class="fas fa-user me-1"></i> الشخصية
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#residence">
            <i class="fas fa-home me-1"></i> السكن
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#education">
            <i class="fas fa-graduation-cap me-1"></i> العلمية
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#job">
            <i class="fas fa-briefcase me-1"></i> المهنية
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#service">
            <i class="fas fa-clock me-1"></i> الخدمة
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#skills">
            <i class="fas fa-star me-1"></i> الطاقات
        </a>
    </li>
</ul>

<div class="tab-content">

    <!-- الشخصية -->
    <div class="tab-pane fade show active" id="personal">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    @{ void Field(string label, string? value) { }  }
                    <div class="col-md-6">
                        <div class="detail-label">الاسم الكامل</div>
                        <div class="detail-value fw-700" style="font-size:1.1rem">@Model.FullName</div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-label">الجنس</div>
                        <div class="detail-value">@genderText</div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-label">تاريخ الميلاد</div>
                        <div class="detail-value">@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("dd/MM/yyyy") : "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">رقم الهاتف</div>
                        <div class="detail-value">@Model.Phone</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">البريد الإلكتروني</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- السكن -->
    <div class="tab-pane fade" id="residence">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="detail-label">المحافظة</div>
                        <div class="detail-value">@(Model.Province ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">القضاء</div>
                        <div class="detail-value">@(Model.District ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">الناحية</div>
                        <div class="detail-value">@(Model.SubDistrict ?? "—")</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">العنوان التفصيلي</div>
                        <div class="detail-value">@(Model.Address ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- العلمية -->
    <div class="tab-pane fade" id="education">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-label">التحصيل الدراسي</div>
                        <div class="detail-value">@(Model.EducationLevel ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">الاختصاص / التخصص</div>
                        <div class="detail-value">@(Model.Specialization ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- المهنية -->
    <div class="tab-pane fade" id="job">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="detail-label">المهنة</div>
                        <div class="detail-value">@(Model.Occupation ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">العنوان الوظيفي</div>
                        <div class="detail-value">@(Model.JobTitle ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">مكان العمل</div>
                        <div class="detail-value">@(Model.WorkPlace ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- الخدمة -->
    <div class="tab-pane fade" id="service">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-label">تاريخ المباشرة بالوظيفة</div>
                        <div class="detail-value">@(Model.ServiceStartDate.HasValue ? Model.ServiceStartDate.Value.ToString("dd/MM/yyyy") : "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">سنوات الخدمة</div>
                        <div class="detail-value">@(Model.ServiceYears.HasValue ? $"{Model.ServiceYears} سنة" : "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- الطاقات -->
    <div class="tab-pane fade" id="skills">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-label">المهارات</div>
                        <div class="detail-value">@(Model.Skills ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">الخبرات</div>
                        <div class="detail-value">@(Model.Experiences ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">الدورات التدريبية</div>
                        <div class="detail-value">@(Model.TrainingCourses ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">اللغات</div>
                        <div class="detail-value">@(Model.Languages ?? "—")</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">مجال الاستفادة من العضو</div>
                        <div class="detail-value">@(Model.BenefitField ?? "—")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <div class="detail-label">ملاحظات</div>
                            <div class="detail-value">@Model.Notes</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .detail-label {
        font-size: .75rem;
        font-weight: 700;
        color: var(--secondary);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 4px;
    }
    .detail-value {
        font-size: .95rem;
        color: #1a1a2e;
        padding: 6px 0;
        border-bottom: 1px dashed #e0e0e0;
    }
</style>
