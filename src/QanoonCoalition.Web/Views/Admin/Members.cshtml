@using QanoonCoalition.Web.Models
@model List<Member>
@{
    ViewData["Title"] = "الأعضاء";
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-users"></i> الأعضاء المعتمدون</h1>
    <span class="badge bg-primary fs-6">الإجمالي: @ViewBag.Total</span>
</div>

@await Html.PartialAsync("_MemberFilterBar")

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الرقم التسلسلي</th>
                    <th>الاسم الكامل</th>
                    <th>رقم الهاتف</th>
                    <th>البريد</th>
                    <th>الحركة</th>
                    <th>مجال الاستفادة</th>
                    <th>تاريخ الإضافة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><span class="serial-badge">@m.SerialNumber</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(m.PhotoPath))
                                {
                                    <img src="@m.PhotoPath" data-zoom="@m.PhotoPath" data-zoom-title="@m.FullName"
                                         title="اضغط لتكبير الصورة"
                                         style="width:36px;height:36px;object-fit:cover;border-radius:50%;border:2px solid #c8e6d5;cursor:zoom-in"/>
                                }
                                else
                                {
                                    <div style="width:36px;height:36px;background:#e8f5ee;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                        <i class="fas fa-user" style="color:#aaa;font-size:.8rem"></i>
                                    </div>
                                }
                                <span class="fw-700">@m.FullName</span>
                            </div>
                        </td>
                        <td>@m.Phone</td>
                        <td>@(m.Email ?? "—")</td>
                        <td>@m.Movement.Name</td>
                        <td style="font-size:.82rem">@(m.BenefitField ?? "—")</td>
                        <td style="font-size:.82rem">@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">
                            <a asp-action="MemberDetails" asp-route-id="@m.Id"
                               class="btn btn-sm btn-outline-primary" title="عرض البيانات">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("PrintMember", "Admin", new { id = m.Id })"
                               target="_blank"
                               class="btn btn-sm btn-outline-secondary" title="طباعة">
                                <i class="fas fa-print"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users"></i>
                <p>لا توجد نتائج مطابقة للفلاتر المحددة.</p>
            </div>
        }
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="#" onclick="mfGoToPage(@p); return false;">@p</a>
                </li>
            }
        </ul>
    </nav>
}
