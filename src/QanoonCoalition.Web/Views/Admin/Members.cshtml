@using QanoonCoalition.Web.Models
@model List<Member>
@{
    ViewData["Title"] = "الأعضاء";
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-users"></i> الأعضاء المعتمدون</h1>
    <span class="badge bg-primary fs-6">الإجمالي: @ViewBag.Total</span>
</div>

<!-- Search Bar -->
<div class="search-bar">
    <form method="get" asp-action="Members" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">البحث</label>
            <input type="text" name="q" class="form-control" value="@ViewBag.Query" placeholder="أدخل كلمة البحث..."/>
        </div>
        <div class="col-md-3">
            <label class="form-label">البحث بواسطة</label>
            <select name="by" class="form-select">
                <option value="name"   selected="@(ViewBag.SearchBy == "name")">الاسم</option>
                <option value="serial" selected="@(ViewBag.SearchBy == "serial")">الرقم التسلسلي</option>
                <option value="phone"  selected="@(ViewBag.SearchBy == "phone")">رقم الهاتف</option>
                <option value="email"  selected="@(ViewBag.SearchBy == "email")">البريد الإلكتروني</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">الحركة</label>
            <select name="movementId" class="form-select">
                <option value="">الكل</option>
                @foreach (var m in (List<Movement>)ViewBag.Movements)
                {
                    <option value="@m.Id" selected="@(ViewBag.MovementId?.ToString() == m.Id.ToString())">@m.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i> بحث</button>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الرقم التسلسلي</th>
                    <th>الاسم الكامل</th>
                    <th>رقم الهاتف</th>
                    <th>البريد</th>
                    <th>الحركة</th>
                    <th>مجال الاستفادة</th>
                    <th>تاريخ الإضافة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><span class="serial-badge">@m.SerialNumber</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(m.PhotoPath))
                                {
                                    <img src="@m.PhotoPath" style="width:36px;height:36px;object-fit:cover;border-radius:50%;border:2px solid #c8e6d5"/>
                                }
                                else
                                {
                                    <div style="width:36px;height:36px;background:#e8f5ee;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                        <i class="fas fa-user" style="color:#aaa;font-size:.8rem"></i>
                                    </div>
                                }
                                <span class="fw-700">@m.FullName</span>
                            </div>
                        </td>
                        <td>@m.Phone</td>
                        <td>@(m.Email ?? "—")</td>
                        <td>@m.Movement.Name</td>
                        <td style="font-size:.82rem">@(m.BenefitField ?? "—")</td>
                        <td style="font-size:.82rem">@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">
                            <a asp-action="MemberDetails" asp-route-id="@m.Id"
                               class="btn btn-sm btn-outline-primary" title="عرض البيانات">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("PrintMember", "Admin", new { id = m.Id })"
                               target="_blank"
                               class="btn btn-sm btn-outline-secondary" title="طباعة">
                                <i class="fas fa-print"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users"></i>
                <p>لا توجد نتائج مطابقة.</p>
            </div>
        }
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Members" 
                       asp-route-q="@ViewBag.Query" asp-route-by="@ViewBag.SearchBy"
                       asp-route-movementId="@ViewBag.MovementId" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
