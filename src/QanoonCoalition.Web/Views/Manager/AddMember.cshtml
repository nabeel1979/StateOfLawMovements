@using QanoonCoalition.Web.Models
@model Member
@{
    ViewData["Title"] = "إضافة عضو";
}
<div class="page-header">
    <h1 class="page-title"><i class="fas fa-user-plus"></i> إضافة عضو جديد</h1>
    <a asp-action="Members" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> العودة</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div><i class="fas fa-exclamation-circle me-1"></i>@e.ErrorMessage</div> }
    </div>
}

<form method="post" asp-action="AddMember" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-0" id="memberTabs">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-personal"><i class="fas fa-user me-1"></i> الشخصية</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-residence"><i class="fas fa-home me-1"></i> السكن</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-education"><i class="fas fa-graduation-cap me-1"></i> العلمية</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-career"><i class="fas fa-briefcase me-1"></i> المهنية</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-service"><i class="fas fa-clock me-1"></i> الخدمة</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-skills"><i class="fas fa-star me-1"></i> الطاقات</a></li>
    </ul>

    <div class="tab-content card border-top-0 rounded-0 rounded-bottom p-4 mb-3" style="border:1px solid #dee2e6">

        <!-- البيانات الشخصية -->
        <div class="tab-pane fade show active" id="tab-personal">
            <div class="row g-3 mt-1">
                <!-- صورة العضو -->
                <div class="col-12">
                    <div class="d-flex align-items-center gap-4">
                        <div id="photoPreview" style="width:100px;height:120px;border:2px dashed #c8e6d5;border-radius:8px;
                             display:flex;align-items:center;justify-content:center;background:#f9fdf9;overflow:hidden;flex-shrink:0">
                            <span class="text-muted" style="font-size:.75rem;text-align:center">
                                <i class="fas fa-camera" style="font-size:1.5rem;display:block;margin-bottom:4px;color:#aaa"></i>
                                صورة العضو
                            </span>
                        </div>
                        <div>
                            <label class="form-label mb-1">صورة العضو <small class="text-muted">(اختياري — JPG/PNG/WEBP، حد أقصى 3MB)</small></label>
                            <input type="file" name="photo" id="photoInput" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" onchange="previewPhoto(this)"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                    <input type="text" name="FullName" class="form-control" value="@Model.FullName" required maxlength="200" placeholder="الاسم الرباعي واللقب"/>
                    <div class="form-text">يجب أن يكون فريداً بين جميع الحركات</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">رقم الهاتف <span class="text-danger">*</span></label>
                    <input type="tel" name="Phone" class="form-control" value="@Model.Phone" required maxlength="20" placeholder="07xx xxx xxxx"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">البريد الإلكتروني <small class="text-muted">(اختياري)</small></label>
                    <input type="email" name="Email" class="form-control" value="@Model.Email" maxlength="200"/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">تاريخ الميلاد</label>
                    <input type="date" name="BirthDate" class="form-control" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))"/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الجنس</label>
                    <select name="Gender" class="form-select">
                        <option value="">— اختر —</option>
                        <option value="1" selected="@(Model.Gender == Gender.Male)">ذكر</option>
                        <option value="2" selected="@(Model.Gender == Gender.Female)">أنثى</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- بيانات السكن -->
        <div class="tab-pane fade" id="tab-residence">
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">المحافظة</label>
                    <select name="Province" class="form-select">
                        <option value="">— اختر —</option>
                        @foreach (var p in new[]{"بغداد","البصرة","نينوى","أربيل","النجف","كربلاء","الأنبار","ديالى","صلاح الدين","واسط","ميسان","ذي قار","المثنى","القادسية","بابل","كركوك","السليمانية","دهوك"})
                        {
                            <option value="@p" selected="@(Model.Province == p)">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">القضاء</label>
                    <input type="text" name="District" class="form-control" value="@Model.District" maxlength="100"/>
                </div>
                <div class="col-md-4">
                    <label class="form-label">الناحية</label>
                    <input type="text" name="SubDistrict" class="form-control" value="@Model.SubDistrict" maxlength="100"/>
                </div>
                <div class="col-12">
                    <label class="form-label">العنوان التفصيلي</label>
                    <textarea name="Address" class="form-control" rows="2" maxlength="500">@Model.Address</textarea>
                </div>
            </div>
        </div>

        <!-- البيانات العلمية -->
        <div class="tab-pane fade" id="tab-education">
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">التحصيل الدراسي</label>
                    <select name="EducationLevel" class="form-select">
                        <option value="">— اختر —</option>
                        @foreach (var lvl in (List<string>)(ViewBag.EducationLevels ?? new List<string>()))
                        {
                            <option value="@lvl" selected="@(Model.EducationLevel == lvl)">@lvl</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الاختصاص</label>
                    <input type="text" name="Specialization" class="form-control" value="@Model.Specialization" maxlength="200"/>
                </div>
            </div>
        </div>

        <!-- البيانات المهنية -->
        <div class="tab-pane fade" id="tab-career">
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">المهنة</label>
                    <input type="text" name="Occupation" class="form-control" value="@Model.Occupation" maxlength="200"/>
                </div>
                <div class="col-md-4">
                    <label class="form-label">العنوان الوظيفي</label>
                    <input type="text" name="JobTitle" class="form-control" value="@Model.JobTitle" maxlength="200"/>
                </div>
                <div class="col-md-4">
                    <label class="form-label">مكان العمل</label>
                    <input type="text" name="WorkPlace" class="form-control" value="@Model.WorkPlace" maxlength="200"/>
                </div>
            </div>
        </div>

        <!-- سنوات الخدمة -->
        <div class="tab-pane fade" id="tab-service">
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">تاريخ المباشرة بالوظيفة</label>
                    <input type="date" name="ServiceStartDate" class="form-control" value="@(Model.ServiceStartDate?.ToString("yyyy-MM-dd"))"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">سنوات الخدمة</label>
                    <input type="number" name="ServiceYears" class="form-control" value="@Model.ServiceYears" min="0" max="60"/>
                </div>
            </div>
        </div>

        <!-- الطاقات والخبرات -->
        <div class="tab-pane fade" id="tab-skills">
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">المهارات</label>
                    <textarea name="Skills" class="form-control" rows="3" maxlength="500">@Model.Skills</textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الخبرات</label>
                    <textarea name="Experiences" class="form-control" rows="3" maxlength="500">@Model.Experiences</textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الدورات التدريبية</label>
                    <textarea name="TrainingCourses" class="form-control" rows="3" maxlength="500">@Model.TrainingCourses</textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">اللغات</label>
                    <input type="text" name="Languages" class="form-control" value="@Model.Languages" maxlength="200" placeholder="العربية، الإنجليزية..."/>
                </div>
                <div class="col-12">
                    <label class="form-label">مجال الاستفادة من العضو <span class="text-danger">*</span></label>
                    <select name="BenefitField" class="form-select">
                        <option value="">— اختر المجال —</option>
                        @foreach (var bf in (List<string>)(ViewBag.BenefitFields ?? new List<string>()))
                        {
                            <option value="@bf" selected="@(Model.BenefitField == bf)">@bf</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2" maxlength="500">@Model.Notes</textarea>
                </div>
            </div>
        </div>

    </div><!-- tab-content -->

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-5">
            <i class="fas fa-save me-2"></i> حفظ العضو
        </button>
        <a asp-action="Members" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>

<script>
function previewPhoto(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            var preview = document.getElementById('photoPreview');
            preview.innerHTML = '<img src="' + e.target.result + '" style="width:100%;height:100%;object-fit:cover"/>';
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
