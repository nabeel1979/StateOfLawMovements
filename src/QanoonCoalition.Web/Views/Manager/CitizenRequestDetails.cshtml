function toggleAnswerDate(statusId) {
    var sel = document.getElementById('newStatusSelect');
    var txt = sel.options[sel.selectedIndex].text.trim();
    var row = document.getElementById('answerDateRow');
    row.style.display = (txt === 'إجابة عنه') ? '' : 'none';
}
toggleAnswerDate();

function previewModalFile(input) {
    var preview = document.getElementById('modalFilePreview');
    var file = input.files[0];
    if (!file) { preview.innerHTML = ''; return; }

    var size = file.size < 1048576
        ? (file.size / 1024).toFixed(1) + ' KB'
        : (file.size / 1048576).toFixed(2) + ' MB';

    var isImage = /\.(jpg|jpeg|png)$/i.test(file.name);
    if (isImage) {
        var reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML =
                '<div class="d-flex align-items-center gap-2 p-2 border rounded">' +
                  '<img src="' + e.target.result + '" style="height:60px;width:60px;object-fit:cover;border-radius:4px"/>' +
                  '<div><div class="small fw-600">' + file.name + '</div>' +
                  '<div class="small text-muted">' + size + '</div></div>' +
                '</div>';
        };
        reader.readAsDataURL(file);
    } else {
        var icon = /\.pdf$/i.test(file.name) ? 'fas fa-file-pdf text-danger'
                 : /\.(doc|docx)$/i.test(file.name) ? 'fas fa-file-word text-primary'
                 : /\.(xls|xlsx)$/i.test(file.name) ? 'fas fa-file-excel text-success'
                 : 'fas fa-file text-secondary';
        preview.innerHTML =
            '<div class="d-flex align-items-center gap-2 p-2 border rounded">' +
              '<i class="' + icon + ' fa-2x"></i>' +
              '<div><div class="small fw-600">' + file.name + '</div>' +
              '<div class="small text-muted">' + size + '</div></div>' +
            '</div>';
    }
}
</script>
}
