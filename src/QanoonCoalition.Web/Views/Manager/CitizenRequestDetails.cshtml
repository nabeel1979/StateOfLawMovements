@model QanoonCoalition.Web.Models.CitizenRequest
@{
    ViewData["Title"] = $"تفاصيل الطلب {Model.RequestCode}";
    var allStatuses = (IList<QanoonCoalition.Web.Models.CitizenRequestStatus>)ViewBag.Statuses;
}

<div id="screenContent">
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-0">
            <i class="fas fa-file-alt me-2 text-primary"></i>
            @Model.RequestCode
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="CitizenRequests">طلبات المواطنين</a></li>
                <li class="breadcrumb-item active">@Model.RequestCode</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="fas fa-print me-1"></i>طباعة
        </button>
        <a asp-action="EditCitizenRequest" asp-route-id="@Model.Id"
           class="btn btn-warning btn-sm">
            <i class="fas fa-edit me-1"></i>تعديل
        </a>
        <form asp-action="DeleteCitizenRequest" method="post" style="display:inline"
              onsubmit="return confirm('هل تريد حذف هذا الطلب نهائياً؟')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id"/>
            <button type="submit" class="btn btn-danger btn-sm" data-no-loading>
                <i class="fas fa-trash me-1"></i>حذف
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-3">
    <div class="col-lg-8">

        <!-- بيانات مقدم الطلب -->
        <div class="card mb-3">
            <div class="card-header fw-600">
                <i class="fas fa-user me-2"></i>بيانات مقدم الطلب
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">الاسم الكامل</div>
                        <div class="fw-600 fs-5">@Model.ApplicantName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">رقم الهاتف</div>
                        <div class="fw-600">@Model.ApplicantPhone</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ApplicantEmail))
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">البريد الإلكتروني</div>
                            <div>@Model.ApplicantEmail</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ContactInformation))
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">معلومات اتصال إضافية</div>
                            <div>@Model.ContactInformation</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- تفاصيل الطلب -->
        <div class="card mb-3">
            <div class="card-header fw-600">
                <i class="fas fa-file-alt me-2"></i>تفاصيل الطلب
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">الموضوع</div>
                    <div class="fw-600 fs-5">@Model.RequestSubject</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">التفاصيل</div>
                    <div class="border rounded p-3 bg-light" style="white-space:pre-wrap">@Model.RequestDetails</div>
                </div>
                <div class="row g-3">
                    @if (Model.ReceivedByMember != null)
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">مستلم الطلب</div>
                            <div class="fw-600">@Model.ReceivedByMember.FullName</div>
                        </div>
                    }
                    @if (Model.Destination != null)
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">الجهة الموجهة إليها</div>
                            <div class="fw-600">@Model.Destination.Name</div>
                            @if (!string.IsNullOrEmpty(Model.DestinationSubText))
                            {
                                <div class="text-muted small">@Model.DestinationSubText</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- المرفقات -->
        <div class="card mb-3">
            <div class="card-header fw-600 d-flex justify-content-between align-items-center">
                <span><i class="fas fa-paperclip me-2"></i>المرفقات (@Model.Attachments.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-success"
                        data-bs-toggle="modal" data-bs-target="#addAttachModal">
                    <i class="fas fa-plus me-1"></i>إضافة مرفق
                </button>
            </div>
            @if (Model.Attachments.Any())
            {
                <div class="p-2">
                    @foreach (var att in Model.Attachments)
                    {
                        var isImg = att.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
                                 || att.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
                                 || att.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase);
                        var isPdf  = att.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                        var isWord = att.FileName.EndsWith(".doc", StringComparison.OrdinalIgnoreCase)
                                  || att.FileName.EndsWith(".docx", StringComparison.OrdinalIgnoreCase);
                        var isXls  = att.FileName.EndsWith(".xls", StringComparison.OrdinalIgnoreCase)
                                  || att.FileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase);
                        var fileIcon = isPdf  ? "fas fa-file-pdf text-danger"
                                     : isWord ? "fas fa-file-word text-primary"
                                     : isXls  ? "fas fa-file-excel text-success"
                                     : "fas fa-file text-secondary";
                        var sizeStr = att.FileSize < 1048576
                            ? $"{att.FileSize / 1024.0:F1} KB"
                            : $"{att.FileSize / 1048576.0:F2} MB";
                        <div class="d-flex align-items-center gap-3 p-2 mb-2 border rounded">
                            <!-- معاينة / أيقونة -->
                            <div class="flex-shrink-0">
                                @if (isImg)
                                {
                                    <img src="@att.FilePath"
                                         data-zoom="@att.FilePath"
                                         data-zoom-title="@att.FileName"
                                         style="width:64px;height:64px;object-fit:cover;border-radius:6px;cursor:zoom-in;border:2px solid #c8e6d5"
                                         title="اضغط لتكبير الصورة"/>
                                }
                                else
                                {
                                    <div style="width:64px;height:64px;display:flex;align-items:center;justify-content:center;background:#f8f9fa;border-radius:6px;border:1px solid #dee2e6">
                                        <i class="@fileIcon fa-2x"></i>
                                    </div>
                                }
                            </div>

                            <!-- تفاصيل الملف -->
                            <div class="flex-grow-1 min-width-0">
                                <div class="fw-600 small text-truncate" title="@att.FileName">@att.FileName</div>
                                <div class="mt-1">
                                    <span class="badge @(att.DocumentType != null ? "bg-primary" : "bg-secondary") me-1">
                                        <i class="fas fa-tag me-1"></i>@(att.DocumentType?.Name ?? "غير محدد")
                                    </span>
                                </div>
                                <div class="text-muted mt-1" style="font-size:.78rem">
                                    <i class="fas fa-weight-hanging me-1"></i>@sizeStr
                                    &nbsp;·&nbsp;
                                    <i class="fas fa-calendar me-1"></i>@att.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    &nbsp;·&nbsp;
                                    <i class="fas fa-user me-1"></i>@att.UploadedByUser.FullName
                                </div>
                            </div>

                            <!-- أزرار الإجراءات -->
                            <div class="flex-shrink-0 d-flex gap-1">
                                @if (isImg)
                                {
                                    <button type="button"
                                            data-zoom="@att.FilePath"
                                            data-zoom-title="@att.FileName"
                                            class="btn btn-sm btn-outline-success" title="عرض">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                }
                                <a href="@att.FilePath" target="_blank"
                                   class="btn btn-sm btn-outline-primary" title="فتح / تنزيل">
                                    <i class="fas fa-external-link-alt"></i>
                                </a>
                                <a href="@att.FilePath" download="@att.FileName"
                                   class="btn btn-sm btn-outline-secondary" title="تنزيل">
                                    <i class="fas fa-download"></i>
                                </a>
                                <form asp-action="DeleteCitizenRequestAttachment" method="post" style="display:inline"
                                      onsubmit="return confirm('حذف المرفق؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attachmentId" value="@att.Id"/>
                                    <input type="hidden" name="requestId" value="@Model.Id"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card-body text-center text-muted py-3">
                    <i class="fas fa-paperclip me-1"></i>لا توجد مرفقات
                </div>
            }
        </div>

    </div>

    <!-- الشريط الجانبي -->
    <div class="col-lg-4">

        <!-- الحالة -->
        <div class="card mb-3">
            <div class="card-header fw-600">
                <i class="fas fa-flag me-2"></i>الحالة الحالية
            </div>
            <div class="card-body">
                <div class="mb-3 text-center">
                    <span class="badge bg-@Model.Status.ColorClass fs-6 px-3 py-2">
                        @Model.Status.Name
                    </span>
                </div>
                <hr/>
                <div class="text-muted small mb-2">تغيير الحالة:</div>
                <form asp-action="ChangeCitizenRequestStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <div class="mb-2">
                        <select name="newStatusId" class="form-select form-select-sm" id="newStatusSelect"
                                onchange="toggleAnswerDate(this.value)">
                            @foreach (var s in allStatuses)
                            {
                                if (s.Id == Model.StatusId)
                                {
                                    <option value="@s.Id" selected>@s.Name</option>
                                }
                                else
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-2" id="answerDateRow" style="display:none">
                        <label class="form-label small">تاريخ الإجابة (اختياري)</label>
                        <input type="datetime-local" name="overrideDate" class="form-control form-control-sm"/>
                        <div class="form-text">اتركه فارغاً لتسجيل التاريخ الحالي</div>
                    </div>
                    <div class="mb-2">
                        <textarea name="notes" class="form-control form-control-sm" rows="2"
                                  placeholder="ملاحظات (اختياري)"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="fas fa-exchange-alt me-1"></i>تطبيق التغيير
                    </button>
                </form>
            </div>
        </div>

        <!-- بيانات الطلب -->
        <div class="card mb-3">
            <div class="card-header fw-600">
                <i class="fas fa-info-circle me-2"></i>بيانات الطلب
            </div>
            <div class="card-body small">
                <div class="row g-2">
                    <div class="col-6 text-muted">كود الطلب</div>
                    <div class="col-6"><code>@Model.RequestCode</code></div>

                    <div class="col-6 text-muted">تاريخ الطلب</div>
                    <div class="col-6">@Model.RequestDate.ToLocalTime().ToString("dd/MM/yyyy")</div>

                    @if (Model.SentDate.HasValue)
                    {
                        <div class="col-6 text-muted">تاريخ الإرسال</div>
                        <div class="col-6">@Model.SentDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    }
                    @if (Model.AnswerDate.HasValue)
                    {
                        <div class="col-6 text-muted">تاريخ الإجابة</div>
                        <div class="col-6">@Model.AnswerDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    }

                    <div class="col-6 text-muted">أضيف بواسطة</div>
                    <div class="col-6">@Model.CreatedByUser.FullName</div>

                    <div class="col-6 text-muted">تاريخ الإنشاء</div>
                    <div class="col-6">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>

                    <div class="col-6 text-muted">آخر تعديل</div>
                    <div class="col-6">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- سجل الحالات -->
        @if (Model.StatusHistory.Any())
        {
            <div class="card">
                <div class="card-header fw-600">
                    <i class="fas fa-history me-2"></i>سجل الحالات
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var h in Model.StatusHistory.OrderByDescending(x => x.ChangedAt))
                        {
                            <li class="list-group-item py-2 px-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (h.FromStatus != null)
                                        {
                                            <span class="badge bg-secondary me-1">@h.FromStatus.Name</span>
                                            <i class="fas fa-arrow-left text-muted mx-1"></i>
                                        }
                                        <span class="badge bg-@h.ToStatus.ColorClass">@h.ToStatus.Name</span>
                                    </div>
                                    <small class="text-muted">@h.ChangedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                </div>
                                @if (!string.IsNullOrEmpty(h.Notes))
                                {
                                    <div class="text-muted small mt-1">@h.Notes</div>
                                }
                                <div class="text-muted" style="font-size:.75rem">@h.ChangedByUser.FullName</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal إضافة مرفق -->
<div class="modal fade" id="addAttachModal" tabindex="-1" aria-labelledby="addAttachModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditCitizenRequest" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id"/>
                <input type="hidden" name="ApplicantName" value="@Model.ApplicantName"/>
                <input type="hidden" name="ApplicantPhone" value="@Model.ApplicantPhone"/>
                <input type="hidden" name="RequestSubject" value="@Model.RequestSubject"/>
                <input type="hidden" name="RequestDetails" value="@Model.RequestDetails"/>

                <div class="modal-header">
                    <h5 class="modal-title" id="addAttachModalLabel">إضافة مرفق جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اختر الملف</label>
                        <input type="file" name="attachments" class="form-control"
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.xlsx,.xls" required
                               onchange="previewModalFile(this)"/>
                        <div id="modalFilePreview" class="mt-2"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نوع الوثيقة</label>
                        <select name="docTypeIds" class="form-select">
                            <option value="">— اختر نوع الوثيقة —</option>
                            @foreach (var dt in (IList<QanoonCoalition.Web.Models.DocumentType>)ViewBag.DocTypes)
                            {
                                <option value="@dt.Id">@dt.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-upload me-1"></i>رفع الملف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

</div><!-- /screenContent -->

<!-- ══════════════════════ منطقة الطباعة (مخفية على الشاشة) ══════════════════════ -->
<div id="printArea">
    <!-- رأس الصفحة -->
    <div class="print-header">
        <div class="print-logo-wrap">
            <img src="/images/logo.jpg" alt="شعار الائتلاف" class="print-logo"/>
        </div>
        <div class="print-org">
            <div class="print-org-main">ائتلاف دولة القانون</div>
            @if (!string.IsNullOrEmpty(ViewBag.MovementName as string))
            {
                <div class="print-org-movement">@ViewBag.MovementName</div>
            }
        </div>
    </div>

    <!-- عنوان الاستمارة + كود الطلب -->
    <div class="print-title-block">
        <div class="print-title">استمارة طلب مواطن</div>
        <div class="print-code-inline">
            <span class="print-code-label">كود الطلب:</span>
            <span class="print-code-val">@Model.RequestCode</span>
        </div>
    </div>

    <!-- القسم الأول: بيانات مقدم الطلب -->
    <div class="print-section-title">أولاً: بيانات مقدم الطلب</div>
    <table class="print-table">
        <tr>
            <th>الاسم الكامل</th>
            <td colspan="3">@Model.ApplicantName</td>
        </tr>
        <tr>
            <th>رقم الهاتف</th>
            <td>@Model.ApplicantPhone</td>
            <th>البريد الإلكتروني</th>
            <td class="print-email-cell">@(string.IsNullOrEmpty(Model.ApplicantEmail) ? "—" : Model.ApplicantEmail)</td>
        </tr>
        @if (!string.IsNullOrEmpty(Model.ContactInformation))
        {
            <tr>
                <th>معلومات اتصال إضافية</th>
                <td colspan="3">@Model.ContactInformation</td>
            </tr>
        }
    </table>

    <!-- القسم الثاني: تفاصيل الطلب -->
    <div class="print-section-title">ثانياً: تفاصيل الطلب</div>
    <table class="print-table">
        <tr>
            <th>تاريخ تقديم الطلب</th>
            <td>@Model.RequestDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
            <th>الحالة الحالية</th>
            <td><strong>@Model.Status.Name</strong></td>
        </tr>
        <tr>
            <th>موضوع الطلب</th>
            <td colspan="3">@Model.RequestSubject</td>
        </tr>
        @if (Model.ReceivedByMember != null)
        {
            <tr>
                <th>مستلم الطلب</th>
                <td>@Model.ReceivedByMember.FullName</td>
                <th>أضيف بواسطة</th>
                <td>@Model.CreatedByUser.FullName</td>
            </tr>
        }
        else
        {
            <tr>
                <th>أضيف بواسطة</th>
                <td colspan="3">@Model.CreatedByUser.FullName</td>
            </tr>
        }
        <tr>
            <th>الجهة الموجَّه إليها</th>
            <td>@(Model.Destination?.Name ?? "—")</td>
            <th>التفصيل</th>
            <td>@(string.IsNullOrEmpty(Model.DestinationSubText) ? "—" : Model.DestinationSubText)</td>
        </tr>
        @if (Model.SentDate.HasValue || Model.AnswerDate.HasValue)
        {
            <tr>
                @if (Model.SentDate.HasValue)
                {
                    <th>تاريخ الإرسال</th>
                    <td>@Model.SentDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</td>
                }
                else
                {
                    <td colspan="2"></td>
                }
                @if (Model.AnswerDate.HasValue)
                {
                    <th>تاريخ الإجابة</th>
                    <td>@Model.AnswerDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</td>
                }
                else
                {
                    <td colspan="2"></td>
                }
            </tr>
        }
    </table>

    <!-- القسم الثالث: تفاصيل الطلب النصية -->
    <div class="print-section-title">ثالثاً: محتوى الطلب</div>
    <div class="print-text-box">@Model.RequestDetails</div>

    <!-- التواقيع — صف واحد بثلاث خانات -->
    <table class="print-sig-table">
        <tr>
            <td class="print-sig-cell">
                <div class="print-sig-title">توقيع مقدم الطلب</div>
                <div class="print-sig-name">@Model.ApplicantName</div>
                <div class="print-sig-space"></div>
                <div class="print-sig-line"></div>
                <div class="print-sig-date">التاريخ: @Model.RequestDate.ToLocalTime().ToString("dd/MM/yyyy")</div>
            </td>
            <td class="print-sig-cell">
                <div class="print-sig-title">توقيع مستلم الطلب</div>
                <div class="print-sig-name">@(Model.ReceivedByMember?.FullName ?? "_______________")</div>
                <div class="print-sig-space"></div>
                <div class="print-sig-line"></div>
                <div class="print-sig-date">التاريخ: ________________</div>
            </td>
            <td class="print-sig-cell">
                <div class="print-sig-title">ختم الإدارة وتوقيعها</div>
                <div class="print-sig-stamp-area"></div>
                <div class="print-sig-line"></div>
                <div class="print-sig-date">التاريخ: ________________</div>
            </td>
        </tr>
    </table>

    <!-- باركود + تذييل -->
    <div class="print-barcode-footer">
        <div class="print-barcode-wrap">
            <svg id="printBarcode"></svg>
            <div class="print-barcode-text">@Model.RequestCode</div>
        </div>
        <div class="print-footer-text">
            ائتلاف دولة القانون © @DateTime.Now.Year
            &nbsp;|&nbsp; طُبع بتاريخ: @DateTime.Now.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script>
// تهيئة الباركود عند تحميل الصفحة
(function() {
    try {
        JsBarcode('#printBarcode', '@Model.RequestCode', {
            format: 'CODE128',
            width: 2,
            height: 40,
            displayValue: false,
            margin: 0,
            lineColor: '#1a7a3f'
        });
    } catch(e) {}

@if (ViewBag.AutoPrint == true)
{
    <text>
    // الطباعة تُستدعى بعد رسم الباركود وتحميل الشعار حتى لا تُطبع الاستمارة ناقصة
    window.addEventListener('load', function () {
        setTimeout(function () { window.print(); }, 300);
