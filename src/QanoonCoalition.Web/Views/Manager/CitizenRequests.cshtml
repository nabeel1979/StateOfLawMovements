@model IList<QanoonCoalition.Web.Services.CitizenRequestListItem>
@using QanoonCoalition.Web.Services
@{
    ViewData["Title"] = "طلبات المواطنين";
    int page = ViewBag.Page, totalPages = ViewBag.TotalPages, total = ViewBag.Total;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header mb-3">
    <h4 class="mb-0"><i class="fas fa-file-alt me-2 text-primary"></i>طلبات المواطنين</h4>
    <small class="text-muted">إجمالي: <strong>@total</strong> طلب</small>
</div>

@await Html.PartialAsync("_CitizenRequestFilterBar")

<!-- الجدول -->
@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-inbox fa-2x d-block mb-2"></i>
        لا توجد طلبات مطابقة
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:40px">#</th>
                        <th>كود الطلب</th>
                        <th>التاريخ</th>
                        <th>اسم مقدم الطلب</th>
                        <th>الموضوع</th>
                        <th>الجهة</th>
                        <th>مستلم الطلب</th>
                        <th class="text-center">الحالة</th>
                        <th class="text-center">مرفقات</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = (page - 1) * 20 + 1; }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-center text-muted small">@(i++)</td>
                            <td>
                                <code class="text-success">@r.RequestCode</code>
                            </td>
                            <td class="small">@r.RequestDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="fw-600">@r.ApplicantName</div>
                                <small class="text-muted">@r.ApplicantPhone</small>
                            </td>
                            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                title="@r.RequestSubject">@r.RequestSubject</td>
                            <td class="small">@(r.DestinationName ?? "—")</td>
                            <td class="small">@(r.ReceivedByMemberName ?? "—")</td>
                            <td class="text-center">
                                <span class="badge bg-@r.StatusColor">@r.StatusName</span>
                            </td>
                            <td class="text-center">
                                @if (r.AttachmentCount > 0)
                                {
                                    <span class="badge bg-secondary">@r.AttachmentCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="dropup">
                                    <button class="btn btn-sm btn-light border" type="button"
                                            data-bs-toggle="dropdown" data-bs-display="static"
                                            aria-expanded="false" title="إجراءات">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="CitizenRequestDetails" asp-route-id="@r.Id">
                                                <i class="fas fa-eye text-primary me-2"></i>عرض
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="EditCitizenRequest" asp-route-id="@r.Id">
                                                <i class="fas fa-edit text-warning me-2"></i>تحرير
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="CitizenRequestDetails" asp-route-id="@r.Id"
                                               asp-route-print="1">
                                                <i class="fas fa-print text-secondary me-2"></i>طباعة
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination — يعيد إرسال نموذج الفلترة لتبقى الشروط مطبَّقة -->
    @if (totalPages > 1)
    {
        <nav class="mt-3 d-flex justify-content-center">
            <ul class="pagination pagination-sm">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <button type="button" class="page-link" onclick="mfGoToPage(@p)">@p</button>
                    </li>
                }
            </ul>
        </nav>
    }
}
