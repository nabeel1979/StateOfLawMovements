@model IList<QanoonCoalition.Web.Services.CitizenRequestListItem>
@using QanoonCoalition.Web.Services
@{
    ViewData["Title"] = "طلبات المواطنين";
    var filter = (CitizenRequestFilter)ViewBag.Filter;
    var statuses = (IList<QanoonCoalition.Web.Models.CitizenRequestStatus>)ViewBag.Statuses;
    var destinations = (IList<QanoonCoalition.Web.Models.RequestDestination>)ViewBag.Destinations;
    var docTypes = (IList<QanoonCoalition.Web.Models.DocumentType>)ViewBag.DocumentTypes;
    dynamic members = ViewBag.Members;
    int page = ViewBag.Page, totalPages = ViewBag.TotalPages, total = ViewBag.Total;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="fas fa-file-alt me-2 text-primary"></i>طلبات المواطنين</h4>
        <small class="text-muted">إجمالي: <strong>@total</strong> طلب</small>
    </div>
    <a asp-action="CreateCitizenRequest" class="btn btn-success">
        <i class="fas fa-plus me-1"></i>إضافة طلب جديد
    </a>
</div>

<!-- فلاتر البحث -->
<div class="card mb-3">
    <div class="card-body pb-2">
        <form method="get" id="filterForm">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small mb-1">بحث</label>
                    <input type="text" name="search" value="@filter.Search"
                           placeholder="كود، اسم، هاتف، موضوع…"
                           class="form-control form-control-sm"/>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">الحالة</label>
                    <select name="statusId" class="form-select form-select-sm">
                        <option value="">الكل</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s.Id" selected="@(filter.StatusId == s.Id)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">الجهة</label>
                    <select name="destinationId" class="form-select form-select-sm">
                        <option value="">الكل</option>
                        @foreach (var d in destinations)
                        {
                            <option value="@d.Id" selected="@(filter.DestinationId == d.Id)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">مستلم الطلب</label>
                    <select name="receivedByMemberId" class="form-select form-select-sm">
                        <option value="">الكل</option>
                        @foreach (var m in members)
                        {
                            <option value="@m.Id" selected="@(filter.ReceivedByMemberId == m.Id)">@m.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">نوع الوثيقة</label>
                    <select name="documentTypeId" class="form-select form-select-sm">
                        <option value="">الكل</option>
                        @foreach (var dt in docTypes)
                        {
                            <option value="@dt.Id" selected="@(filter.DocumentTypeId == dt.Id)">@dt.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">من تاريخ</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm"
                           value="@(filter.FromDate?.ToString("yyyy-MM-dd"))"/>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">إلى تاريخ</label>
                    <input type="date" name="toDate" class="form-control form-control-sm"
                           value="@(filter.ToDate?.ToString("yyyy-MM-dd"))"/>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">
                        <i class="fas fa-search"></i> بحث
                    </button>
                    <a asp-action="CitizenRequests" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- الجدول -->
@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-inbox fa-2x d-block mb-2"></i>
        لا توجد طلبات مطابقة
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:40px">#</th>
                        <th>كود الطلب</th>
                        <th>التاريخ</th>
                        <th>اسم مقدم الطلب</th>
                        <th>الموضوع</th>
                        <th>الجهة</th>
                        <th>مستلم الطلب</th>
                        <th class="text-center">الحالة</th>
                        <th class="text-center">مرفقات</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = (page - 1) * 20 + 1; }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-center text-muted small">@(i++)</td>
                            <td>
                                <code class="text-success">@r.RequestCode</code>
                            </td>
                            <td class="small">@r.RequestDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="fw-600">@r.ApplicantName</div>
                                <small class="text-muted">@r.ApplicantPhone</small>
                            </td>
                            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                title="@r.RequestSubject">@r.RequestSubject</td>
                            <td class="small">@(r.DestinationName ?? "—")</td>
                            <td class="small">@(r.ReceivedByMemberName ?? "—")</td>
                            <td class="text-center">
                                <span class="badge bg-@r.StatusColor">@r.StatusName</span>
                            </td>
                            <td class="text-center">
                                @if (r.AttachmentCount > 0)
                                {
                                    <span class="badge bg-secondary">@r.AttachmentCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="CitizenRequestDetails" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-outline-primary" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="EditCitizenRequest" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-outline-warning" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteCitizenRequest" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف هذا الطلب؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-3 d-flex justify-content-center">
            <ul class="pagination pagination-sm">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="CitizenRequests"
                           asp-route-page="@p"
                           asp-route-search="@filter.Search"
                           asp-route-statusId="@filter.StatusId"
                           asp-route-destinationId="@filter.DestinationId">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
