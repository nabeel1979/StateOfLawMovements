@model IList<QanoonCoalition.Web.Models.RequestDestination>
@{
    ViewData["Title"] = "الجهات";
    var types = new[] { "وزارة", "هيئة", "دائرة", "محافظة", "مؤسسة", "أخرى" };
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-building me-2 text-primary"></i>الجهات</h4>
    <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#destModal"
            onclick="openAdd()">
        <i class="fas fa-plus me-1"></i>إضافة جهة
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:50px">#</th>
                    <th>اسم الجهة</th>
                    <th>النوع</th>
                    <th class="text-center">الترتيب</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="text-center text-muted">@(i++)</td>
                        <td class="fw-600">@d.Name</td>
                        <td><span class="badge bg-secondary">@d.Type</span></td>
                        <td class="text-center">@d.DisplayOrder</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-warning"
                                    onclick="openEdit(@d.Id, '@d.Name.Replace("'", "\\'")','@d.Type', @d.DisplayOrder)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form asp-action="DeleteDestination" method="post" style="display:inline"
                                  onsubmit="return confirm('حذف الجهة؟')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.Id"/>
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="destModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SaveDestination" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="destId" value="0"/>
                <div class="modal-header">
                    <h5 class="modal-title" id="destModalTitle">إضافة جهة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اسم الجهة <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="destName" class="form-control" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نوع الجهة</label>
                        <select name="type" id="destType" class="form-select">
                            <option value="">— اختر —</option>
                            @foreach (var t in types)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الترتيب</label>
                        <input type="number" name="displayOrder" id="destOrder" class="form-control"
                               value="1" min="1"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openAdd() {
    document.getElementById('destId').value = '0';
    document.getElementById('destName').value = '';
    document.getElementById('destType').value = '';
    document.getElementById('destOrder').value = '1';
    document.getElementById('destModalTitle').textContent = 'إضافة جهة';
}

function openEdit(id, name, type, order) {
    document.getElementById('destId').value = id;
    document.getElementById('destName').value = name;
    document.getElementById('destType').value = type || '';
    document.getElementById('destOrder').value = order;
    document.getElementById('destModalTitle').textContent = 'تعديل جهة';
    new bootstrap.Modal(document.getElementById('destModal')).show();
}
</script>
}
