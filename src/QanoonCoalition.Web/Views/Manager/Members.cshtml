@using QanoonCoalition.Web.Models
@model List<Member>
@{
    ViewData["Title"] = "الأعضاء";
    ViewBag.ShowAddMember = true;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-users"></i> الأعضاء</h1>
</div>

@await Html.PartialAsync("_MemberFilterBar")

<div class="card">
    <div class="card-header">
        <i class="fas fa-users"></i> قائمة الأعضاء
        <span class="badge bg-primary ms-2">@ViewBag.Total عضو</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover" style="min-width:750px">
            <thead>
                <tr>
                    <th>الرقم التسلسلي</th>
                    <th>الاسم الكامل</th>
                    <th>رقم الهاتف</th>
                    <th>البريد</th>
                    <th>مجال الاستفادة</th>
                    <th>تاريخ الإضافة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><span class="serial-badge">@m.SerialNumber</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(m.PhotoPath))
                                {
                                    <img src="@m.PhotoPath" data-zoom="@m.PhotoPath" data-zoom-title="@m.FullName"
                                         title="اضغط لتكبير الصورة"
                                         style="width:36px;height:36px;object-fit:cover;border-radius:50%;border:2px solid #c8e6d5;cursor:zoom-in"/>
                                }
                                else
                                {
                                    <div style="width:36px;height:36px;background:#e8f5ee;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                        <i class="fas fa-user" style="color:#aaa;font-size:.8rem"></i>
                                    </div>
                                }
                                <span class="fw-700">@m.FullName</span>
                            </div>
                        </td>
                        <td>@m.Phone</td>
                        <td>@(m.Email ?? "—")</td>
                        <td style="font-size:.82rem">@(m.BenefitField ?? "—")</td>
                        <td style="font-size:.82rem">@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">
                            <a asp-action="EditMember" asp-route-id="@m.Id"
                               class="btn btn-sm btn-outline-primary" title="تعديل">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("PrintMember", "Manager", new { id = m.Id })"
                               target="_blank"
                               class="btn btn-sm btn-outline-secondary me-1" title="طباعة بطاقة العضو">
                                <i class="fas fa-print"></i>
                            </a>
                            <form asp-action="DeleteMember" method="post" class="d-inline"
                                  data-confirm="سيتم حذف العضو &quot;@m.FullName&quot; نهائياً مع صورته. لا يمكن التراجع عن هذه العملية."
                                  data-confirm-type="danger">
                                <input type="hidden" name="id" value="@m.Id"/>
                                <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                <button type="submit" class="btn btn-sm btn-outline-danger me-1" title="حذف العضو">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users"></i>
                <p>لا توجد نتائج مطابقة للفلاتر المحددة.</p>
            </div>
        }
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    int curPage   = (int)ViewBag.Page;
    int totalPgs  = (int)ViewBag.TotalPages;
    int window    = 3; // عدد الصفحات قبل وبعد الصفحة الحالية
    int pFrom     = Math.Max(1, curPage - window);
    int pTo       = Math.Min(totalPgs, curPage + window);
    <nav class="mt-3">
        <ul class="pagination justify-content-center flex-wrap">
            @{ var prevD = curPage == 1 ? "disabled" : ""; var nextD = curPage == totalPgs ? "disabled" : ""; }
            <li class='page-item @prevD'><a class="page-link" href="#" onclick="mfGoToPage(@(curPage-1)); return false;"><i class="fas fa-chevron-right"></i></a></li>
            @if (pFrom > 1)
            {
                <li class="page-item"><a class="page-link" href="#" onclick="mfGoToPage(1); return false;">1</a></li>
                @if (pFrom > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            }
            @for (int p = pFrom; p <= pTo; p++)
            {
                var pgCls = p == curPage ? "active" : "";
                <li class='page-item @pgCls'><a class="page-link" href="#" onclick="mfGoToPage(@p); return false;">@p</a></li>
            }
            @if (pTo < totalPgs)
            {
                @if (pTo < totalPgs - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                <li class="page-item"><a class="page-link" href="#" onclick="mfGoToPage(@totalPgs); return false;">@totalPgs</a></li>
            }
            <li class='page-item @nextD'><a class="page-link" href="#" onclick="mfGoToPage(@(curPage+1)); return false;"><i class="fas fa-chevron-left"></i></a></li>
        </ul>
        <p class="text-center text-muted small mt-1">
            صفحة @curPage من @totalPgs — إجمالي @ViewBag.Total سجل
        </p>
    </nav>
}
