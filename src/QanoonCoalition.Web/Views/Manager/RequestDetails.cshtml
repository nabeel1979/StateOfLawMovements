@using QanoonCoalition.Web.Models
@model JoinRequest
@{
    ViewData["Title"] = "تفاصيل الطلب";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible mb-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-file-alt"></i> تفاصيل الطلب</h1>
    <div class="d-flex gap-2 align-items-center">
        <code style="font-size:.9rem">@Model.ReferenceNumber</code>
        @switch (Model.Status)
        {
            case RequestStatus.Pending:  <span class="status-pending">قيد المراجعة</span>  break;
            case RequestStatus.Approved: <span class="status-approved">مقبول</span>        break;
            case RequestStatus.Rejected: <span class="status-rejected">مرفوض</span>        break;
        }
        <a asp-action="JoinRequests" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right"></i> العودة
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left: Data Tabs -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><i class="fas fa-user"></i> بيانات مقدم الطلب</div>
            <div class="card-body p-0">
                <ul class="nav nav-tabs px-3 pt-2" id="reqTabs">
                    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#rp0"><i class="fas fa-user me-1"></i> الشخصية</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#rp1"><i class="fas fa-home me-1"></i> السكن</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#rp2"><i class="fas fa-graduation-cap me-1"></i> العلمية</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#rp3"><i class="fas fa-briefcase me-1"></i> المهنية</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#rp4"><i class="fas fa-star me-1"></i> الطاقات</a></li>
                </ul>
                <div class="tab-content p-4">

                    <!-- الشخصية -->
                    <div class="tab-pane fade show active" id="rp0">
                        <div class="row g-3">
                            <div class="col-auto">
                                @await Html.PartialAsync("_MemberPhoto", (Model.PhotoPath, Model.FullName))
                            </div>
                            <div class="col">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="text-muted" style="font-size:.78rem">الاسم الكامل</div>
                                        <div class="fw-800 fs-5">@Model.FullName</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted" style="font-size:.78rem">رقم الهاتف</div>
                                        <div class="fw-600">@Model.Phone</div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <div class="col-md-6">
                                            <div class="text-muted" style="font-size:.78rem">البريد الإلكتروني</div>
                                            <div>@Model.Email</div>
                                        </div>
                                    }
                                    @if (Model.BirthDate.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <div class="text-muted" style="font-size:.78rem">تاريخ الميلاد</div>
                                            <div>@Model.BirthDate.Value.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    }
                                    @if (Model.Gender.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <div class="text-muted" style="font-size:.78rem">الجنس</div>
                                            <div>@(Model.Gender == Gender.Male ? "ذكر" : "أنثى")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- السكن -->
                    <div class="tab-pane fade" id="rp1">
                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(Model.Province))
                            {
                                <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">المحافظة</div><div class="fw-600">@Model.Province</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.District))
                            {
                                <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">القضاء</div><div>@Model.District</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.SubDistrict))
                            {
                                <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">الناحية</div><div>@Model.SubDistrict</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <div class="col-12"><div class="text-muted" style="font-size:.78rem">العنوان التفصيلي</div><div>@Model.Address</div></div>
                            }

                            @* ── بيانات المركز الانتخابي ── *@
                            @if (!string.IsNullOrEmpty(Model.VoterNumber) || !string.IsNullOrEmpty(Model.SchoolName))
                            {
                                <div class="col-12"><hr class="my-1"/></div>
                                @if (!string.IsNullOrEmpty(Model.VoterNumber))
                                {
                                    <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">رقم الناخب</div><div class="fw-600">@Model.VoterNumber</div></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.ElectionSide))
                                {
                                    <div class="col-md-4">
                                        <div class="text-muted" style="font-size:.78rem">الجانب</div>
                                        <div>
                                            @if (Model.ElectionSide == "الكرخ")
                                            {
                                                <span class="badge" style="background:#1a5c38">الكرخ</span>
                                            }
                                            else if (Model.ElectionSide == "الرصافة")
                                            {
                                                <span class="badge" style="background:#1a3a8c">الرصافة</span>
                                            }
                                            else
                                            {
                                                <span>@Model.ElectionSide</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.ElectionCenterCode))
                                {
                                    <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">رقم المركز</div><div class="fw-600">@Model.ElectionCenterCode</div></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.SchoolName))
                                {
                                    <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">اسم المركز الانتخابي</div><div>@Model.SchoolName</div></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.SchoolAddress))
                                {
                                    <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">عنوان المركز الانتخابي</div><div>@Model.SchoolAddress</div></div>
                                }

                                @* زر اعتماد المركز — يظهر فقط إذا كان المركز مُدخلاً يدوياً (لا يوجد رقم مركز معروف) *@
                                @if (string.IsNullOrEmpty(Model.ElectionCenterCode) && !string.IsNullOrEmpty(Model.SchoolName))
                                {
                                    <div class="col-12 mt-1">
                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                onclick="document.getElementById('approveCenterModal').style.display='flex'">
                                            <i class="fas fa-landmark me-1"></i> اعتماد المركز الانتخابي وإضافته للقائمة
                                        </button>
                                    </div>
                                }
                            }

                            @if (string.IsNullOrEmpty(Model.Province) && string.IsNullOrEmpty(Model.Address) && string.IsNullOrEmpty(Model.SchoolName) && string.IsNullOrEmpty(Model.VoterNumber))
                            {
                                <div class="col-12 text-muted text-center py-3">لم يتم إدخال بيانات السكن</div>
                            }
                        </div>
                    </div>

                    <!-- العلمية -->
                    <div class="tab-pane fade" id="rp2">
                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(Model.EducationLevel))
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">التحصيل الدراسي</div><div class="fw-600">@Model.EducationLevel</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Specialization))
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">الاختصاص</div><div>@Model.Specialization</div></div>
                            }
                            @if (string.IsNullOrEmpty(Model.EducationLevel) && string.IsNullOrEmpty(Model.Specialization))
                            {
                                <div class="col-12 text-muted text-center py-3">لم يتم إدخال البيانات العلمية</div>
                            }
                        </div>
                    </div>

                    <!-- المهنية + الخدمة -->
                    <div class="tab-pane fade" id="rp3">
                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(Model.Occupation))
                            {
                                <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">المهنة</div><div class="fw-600">@Model.Occupation</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.JobTitle))
                            {
                                <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">العنوان الوظيفي</div><div>@Model.JobTitle</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.WorkPlace))
                            {
                                <div class="col-md-4"><div class="text-muted" style="font-size:.78rem">مكان العمل</div><div>@Model.WorkPlace</div></div>
                            }
                            @if (Model.ServiceStartDate.HasValue)
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">تاريخ المباشرة</div><div>@Model.ServiceStartDate.Value.ToString("dd/MM/yyyy")</div></div>
                            }
                            @if (Model.ServiceYears.HasValue)
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">سنوات الخدمة</div><div class="fw-700">@Model.ServiceYears سنة</div></div>
                            }
                        </div>
                    </div>

                    <!-- الطاقات -->
                    <div class="tab-pane fade" id="rp4">
                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(Model.Skills))
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">المهارات</div><div>@Model.Skills</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Experiences))
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">الخبرات</div><div>@Model.Experiences</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.TrainingCourses))
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">الدورات التدريبية</div><div>@Model.TrainingCourses</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Languages))
                            {
                                <div class="col-md-6"><div class="text-muted" style="font-size:.78rem">اللغات</div><div>@Model.Languages</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.BenefitField))
                            {
                                <div class="col-12"><div class="text-muted" style="font-size:.78rem">مجال الاستفادة المقترح</div><div class="fw-600">@Model.BenefitField</div></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="col-12"><div class="text-muted" style="font-size:.78rem">ملاحظات</div><div>@Model.Notes</div></div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Right: Actions -->
    <div class="col-lg-4">
        @{
            bool hasManualCenter = Model.Status == RequestStatus.Pending
                && string.IsNullOrEmpty(Model.ElectionCenterCode)
                && !string.IsNullOrEmpty(Model.SchoolName);
        }
        @if (Model.Status == RequestStatus.Pending)
        {
            @* ── كارد المركز الانتخابي غير المعتمد ── *@
            if (hasManualCenter)
            {
                <div class="card mb-3" style="border-top:4px solid #f59e0b">
                    <div class="card-header" style="background:#fffbeb;border-bottom:1px solid #fde68a">
                        <i class="fas fa-landmark" style="color:#d97706"></i>
                        <span style="color:#92400e;font-weight:700"> المركز الانتخابي يحتاج إلى قرار</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-2" style="font-size:.85rem;color:#78350f">
                            <div><strong>@Model.SchoolName</strong></div>
                            @if (!string.IsNullOrEmpty(Model.ElectionSide)) { <div class="text-muted">@Model.ElectionSide</div> }
                            @if (!string.IsNullOrEmpty(Model.SchoolAddress)) { <div class="text-muted" style="font-size:.8rem">@Model.SchoolAddress</div> }
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-warning btn-sm"
                                    style="color:#1a1a1a"
                                    onclick="document.getElementById('approveCenterModal').style.display='flex'">
                                <i class="fas fa-check-circle me-1"></i> اعتماد المركز وإضافته للقائمة
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    onclick="showConfirm('سيتم إلغاء بيانات المركز الانتخابي وقبول الطلب. هل تريد المتابعة؟', 'clearApprove', 'warning')">
                                <i class="fas fa-times me-1"></i> إلغاء المركز والموافقة على الطلب
                            </button>
                        </div>
                    </div>
                </div>
                <form id="clearApproveForm" method="post" asp-action="ApproveRequestClearCenter" asp-route-id="@Model.Id" style="display:none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="benefitField" id="clearApproveBenefit"/>
                </form>
            }

            @* ── كارد الموافقة ── *@
            <div class="card mb-3">
                <div class="card-header" style="border-right:4px solid var(--accent)">
                    <i class="fas fa-check-circle text-success"></i> الموافقة على الطلب
                </div>
                <div class="card-body">
                    <form method="post" asp-action="ApproveRequest" asp-route-id="@Model.Id" id="approveForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">مجال الاستفادة من العضو <span class="text-danger">*</span></label>
                            <select name="benefitField" id="benefitFieldSelect" class="form-select" required>
                                <option value="">— اختر المجال —</option>
                                @foreach (var bf in (List<string>)(ViewBag.BenefitFields ?? new List<string>()))
                                {
                                    <option value="@bf" selected="@(Model.BenefitField == bf)">@bf</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-success w-100"
                                onclick="showConfirm('هل تريد قبول هذا الطلب وتحويله إلى عضو؟', 'approve', 'success')">
                            <i class="fas fa-check me-2"></i> قبول وتحويل إلى عضو
                        </button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header" style="border-right:4px solid #dc3545">
                    <i class="fas fa-times-circle text-danger"></i> رفض الطلب
                </div>
                <div class="card-body">
                    <form method="post" asp-action="RejectRequest" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">سبب الرفض <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="3" required></textarea>
                        </div>
                        <button type="button" class="btn btn-danger w-100"
                                onclick="showConfirm('هل تريد رفض هذا الطلب؟', 'reject', 'danger')">
                            <i class="fas fa-times me-2"></i> رفض الطلب
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card @(Model.Status == RequestStatus.Approved ? "" : "mb-3")" style="border-top:4px solid @(Model.Status == RequestStatus.Approved ? "var(--accent)" : "#dc3545")">
                <div class="card-body text-center py-4">
                    @if (Model.Status == RequestStatus.Approved)
                    {
                        <i class="fas fa-check-circle text-success" style="font-size:3rem"></i>
                        <h5 class="mt-3">تمت الموافقة</h5>
                    }
                    else
                    {
                        <i class="fas fa-times-circle text-danger" style="font-size:3rem"></i>
                        <h5 class="mt-3">تم الرفض</h5>
                        @if (!string.IsNullOrEmpty(Model.RejectionReason))
                        {
                            <div class="alert alert-danger mt-2 text-start" style="font-size:.85rem">@Model.RejectionReason</div>
                        }
                    }
                    <p class="text-muted" style="font-size:.82rem">
                        بواسطة: @(Model.ReviewedByUser?.FullName ?? "—")<br/>
                        @(Model.ReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                    </p>
                </div>
            </div>

            @* زر سحب القبول — يظهر فقط للطلبات المقبولة *@
            @if (Model.Status == RequestStatus.Approved)
            {
                <div class="card mt-3" style="border-top:4px solid #dc3545">
                    <div class="card-header" style="border-right:4px solid #dc3545">
                        <i class="fas fa-undo text-danger"></i> سحب القبول ورفض الطلب
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3" style="font-size:.83rem">
                            سيتم <strong>حذف العضو</strong> المرتبط بهذا الطلب وتغيير حالته إلى مرفوض.
                        </p>
                        <form method="post" asp-action="RevokeApproval" asp-route-id="@Model.Id" id="revokeForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">سبب الرفض <span class="text-danger">*</span></label>
                                <textarea name="reason" id="revokeReason" class="form-control" rows="2" required placeholder="أدخل سبب سحب القبول..."></textarea>
                            </div>
                            <button type="button" class="btn btn-danger w-100"
                                    onclick="showConfirm('سيتم حذف العضو ورفض الطلب نهائياً. هل أنت متأكد؟', 'revoke', 'danger')">
                                <i class="fas fa-undo me-2"></i> سحب القبول وحذف العضو
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

        <!-- Custom Confirm Modal -->
        <div id="confirmModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);align-items:center;justify-content:center;">
            <div style="background:#fff;border-radius:16px;width:90%;max-width:420px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);animation:fadeIn .2s ease">
                <div id="modalHeader" style="padding:1.25rem 1.5rem;display:flex;align-items:center;gap:.75rem">
                    <div id="modalIcon" style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0"></div>
                    <div>
                        <div style="font-weight:700;font-size:1rem;color:#fff" id="modalTitle">تأكيد العملية</div>
                        <div style="font-size:.85rem;color:rgba(255,255,255,.85)" id="modalMsg"></div>
                    </div>
                </div>
                <div style="padding:1.25rem 1.5rem;display:flex;gap:.75rem;justify-content:flex-end">
                    <button onclick="closeConfirm()" style="background:#f1f5f9;color:#475569;border:none;border-radius:8px;padding:.6rem 1.4rem;font-family:inherit;font-size:.95rem;font-weight:600;cursor:pointer">
                        إلغاء
                    </button>
                    <button id="modalConfirmBtn" style="border:none;border-radius:8px;padding:.6rem 1.4rem;font-family:inherit;font-size:.95rem;font-weight:600;cursor:pointer;color:#fff">
                        تأكيد
                    </button>
                </div>
            </div>
        </div>

        <!-- Request Meta -->
        <div class="card mt-3">
            <div class="card-body" style="font-size:.82rem">
                <div class="mb-2"><span class="text-muted">الرقم المرجعي: </span><code>@Model.ReferenceNumber</code></div>
                <div><span class="text-muted">تاريخ الطلب: </span>@Model.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>

@* ── مودال اعتماد المركز الانتخابي ── *@
@if (!string.IsNullOrEmpty(Model.SchoolName) && string.IsNullOrEmpty(Model.ElectionCenterCode))
{
<div id="approveCenterModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;width:90%;max-width:480px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
        <div style="background:#1a5c38;padding:1.25rem 1.5rem;display:flex;align-items:center;gap:.75rem">
            <i class="fas fa-landmark" style="color:#fff;font-size:1.4rem"></i>
            <div style="color:#fff;font-weight:700;font-size:1rem">اعتماد المركز الانتخابي</div>
        </div>
        <form method="post" asp-action="ApproveElectionCenter" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div class="p-4">
                <p class="text-muted mb-3" style="font-size:.88rem">سيتم إضافة هذا المركز إلى قائمة المراكز الانتخابية. يمكنك تعديل البيانات قبل الاعتماد.</p>
                <div class="mb-3">
                    <label class="form-label fw-600">الجانب</label>
                    <select name="groupName" class="form-select">
                        <option value="">— غير محدد —</option>
                        @if (Model.ElectionSide == "الكرخ") { <option value="الكرخ" selected="selected">الكرخ</option> } else { <option value="الكرخ">الكرخ</option> }
                        @if (Model.ElectionSide == "الرصافة") { <option value="الرصافة" selected="selected">الرصافة</option> } else { <option value="الرصافة">الرصافة</option> }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-600">رقم المركز</label>
                    <input name="code" class="form-control" value="@Model.ElectionCenterCode" placeholder="اختياري"/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-600">اسم المركز <span class="text-danger">*</span></label>
                    <input name="centerName" class="form-control" value="@Model.SchoolName" required/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-600">عنوان المركز</label>
                    <input name="centerAddress" class="form-control" value="@Model.SchoolAddress"/>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" onclick="document.getElementById('approveCenterModal').style.display='none'"
                            class="btn btn-outline-secondary">إلغاء</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i> اعتماد وإضافة
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
}

@section Scripts {
<style>
    @@keyframes fadeIn { from { opacity:0; transform:scale(.95) } to { opacity:1; transform:scale(1) } }
</style>
<script>
    var _pendingAction = null;
    function showConfirm(msg, action, type) {
        _pendingAction = action;
        var colors = { success: '#1a5c38', danger: '#dc2626', warning: '#d97706' };
        var icons  = { success: '✓', danger: '✕', warning: '!' };
        var titles = { success: 'تأكيد القبول', danger: 'تأكيد الرفض', warning: 'تأكيد العملية' };
        var c = colors[type] || '#1a5c38';
        document.getElementById('modalHeader').style.background = c;
        document.getElementById('modalIcon').style.background = 'rgba(255,255,255,0.2)';
        document.getElementById('modalIcon').style.color = '#fff';
        document.getElementById('modalIcon').innerText = icons[type];
        document.getElementById('modalTitle').innerText = titles[type];
        document.getElementById('modalMsg').innerText = msg;
        document.getElementById('modalConfirmBtn').style.background = c;
        document.getElementById('confirmModal').style.display = 'flex';
    }
    function closeConfirm() {
        document.getElementById('confirmModal').style.display = 'none';
        _pendingAction = null;
    }
    document.getElementById('modalConfirmBtn').addEventListener('click', function () {
        if (_pendingAction === 'approve') {
            document.getElementById('approveForm').submit();
        } else if (_pendingAction === 'reject') {
            document.querySelector('form[action*="RejectRequest"]').submit();
        } else if (_pendingAction === 'clearApprove') {
            var bf = document.getElementById('benefitFieldSelect');
            if (bf) document.getElementById('clearApproveBenefit').value = bf.value;
            document.getElementById('clearApproveForm').submit();
        } else if (_pendingAction === 'revoke') {
            document.getElementById('revokeForm').submit();
        }
        closeConfirm();
    });
    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) closeConfirm();
    });
</script>
}
