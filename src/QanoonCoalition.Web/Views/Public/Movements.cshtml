@model List<QanoonCoalition.Web.Models.Movement>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>استمارة الانضمام — ائتلاف دولة القانون</title>
    <!-- Open Graph -->
    <meta property="og:title"       content="استمارات الانضمام — ائتلاف دولة القانون"/>
    <meta property="og:description" content="اختر الحركة السياسية التي تريد الانضمام إليها ضمن ائتلاف دولة القانون"/>
    <meta property="og:image"       content="https://stateoflawmovements.gcc.iq/images/logo.jpg"/>
    <meta property="og:image:width"  content="500"/>
    <meta property="og:image:height" content="500"/>
    <meta property="og:type"        content="website"/>
    <meta property="og:url"         content="http://form.gcc.iq/"/>
    <meta property="og:site_name"   content="ائتلاف دولة القانون"/>
    <meta name="twitter:card"       content="summary_large_image"/>
    <meta name="twitter:image"      content="https://stateoflawmovements.gcc.iq/images/logo.jpg"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Cairo', sans-serif; }
        body {
            background: linear-gradient(160deg, #1a5c38, #2d8653);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .page-header {
            text-align: center;
            color: #fff;
            margin-bottom: 2rem;
        }
        .page-header img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,0.5);
            margin-bottom: 1rem;
        }
        .page-header h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.25rem; }
        .page-header p { font-size: 1rem; opacity: 0.85; }
        .movements-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.25rem;
            width: 100%;
            max-width: 900px;
        }
        .movement-card {
            background: #fff;
            border-radius: 16px;
            padding: 1.75rem 1.5rem;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            transition: transform 0.2s, box-shadow 0.2s;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }
        .movement-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 40px rgba(0,0,0,0.2);
            text-decoration: none;
            color: inherit;
        }
        .movement-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1a5c38, #2d8653);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.6rem;
        }
        .movement-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1a5c38;
        }
        .movement-gov {
            font-size: 0.85rem;
            color: #888;
        }
        .btn-join {
            background: linear-gradient(135deg, #1a5c38, #2d8653);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-join:hover { opacity: 0.88; color: #fff; text-decoration: none; }
        .empty-state {
            background: #fff;
            border-radius: 16px;
            padding: 3rem 2rem;
            text-align: center;
            color: #555;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
        }
        .empty-state i { font-size: 3rem; color: #ccc; margin-bottom: 1rem; }
        .footer-note {
            color: rgba(255,255,255,0.6);
            font-size: 0.8rem;
            margin-top: 2rem;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="page-header">
        <img src="/images/logo.jpg" alt="ائتلاف دولة القانون" onerror="this.style.display='none'"/>
        <h1>ائتلاف دولة القانون</h1>
        <p>اختر الحركة التي تريد الانضمام إليها</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-building"></i>
            <p class="mb-0">لا توجد حركات متاحة حالياً</p>
        </div>
    }
    else
    {
        <div class="movements-grid">
            @foreach (var m in Model)
            {
                <a href="http://form.gcc.iq/join/@m.PublicToken" class="movement-card">
                    <div class="movement-icon">
                        <i class="fas fa-landmark"></i>
                    </div>
                    <div class="movement-name">@m.Name</div>
                    @if (!string.IsNullOrEmpty(m.Governorate))
                    {
                        <div class="movement-gov"><i class="fas fa-map-marker-alt me-1"></i>@m.Governorate</div>
                    }
                    <span class="btn-join">
                        <i class="fas fa-file-alt me-1"></i> تقديم طلب انضمام
                    </span>
                </a>
            }
        </div>
    }

    <div class="footer-note">نظام إدارة الحركات السياسية &copy; @DateTime.Now.Year</div>
</body>
</html>
