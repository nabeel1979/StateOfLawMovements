<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ائتلاف دولة القانون</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "authenticated" : "public-page")">

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo">
                    <img src="/images/logo.jpg" alt="ائتلاف دولة القانون"
                         style="width:52px;height:52px;object-fit:cover;border-radius:50%;border:2px solid rgba(255,255,255,.3)"/>
                </div>
                <div class="brand-text">
                    <span class="brand-main">ائتلاف دولة القانون</span>
                    <span class="brand-sub">نظام إدارة الحركات</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-section-title">الإدارة العامة</div>
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                        <i class="fas fa-chart-line"></i><span>لوحة التحكم</span>
                    </a>
                    <div class="nav-section-title">الحركات</div>
                    <a asp-controller="Admin" asp-action="Movements" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Movements" ? "active" : "")">
                        <i class="fas fa-sitemap"></i><span>الحركات</span>
                    </a>
                    <a asp-controller="Admin" asp-action="CreateMovement" class="nav-item">
                        <i class="fas fa-plus-circle"></i><span>إنشاء حركة</span>
                    </a>
                    <div class="nav-section-title">الأعضاء والطلبات</div>
                    <a asp-controller="Admin" asp-action="Members" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Members" ? "active" : "")">
                        <i class="fas fa-users"></i><span>الأعضاء</span>
                    </a>
                    <a asp-controller="Admin" asp-action="JoinRequests" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "JoinRequests" ? "active" : "")">
                        <i class="fas fa-file-alt"></i><span>طلبات الانضمام</span>
                    </a>
                    <div class="nav-section-title">التقارير</div>
                    <a asp-controller="Admin" asp-action="Reports" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
                        <i class="fas fa-chart-bar"></i><span>التقارير</span>
                    </a>
                    <a asp-controller="Admin" asp-action="AuditLogs" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")">
                        <i class="fas fa-history"></i><span>سجل العمليات</span>
                    </a>
                    <div class="nav-section-title">الإعدادات</div>
                    <a asp-controller="Admin" asp-action="SystemConstants" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "SystemConstants" ? "active" : "")">
                        <i class="fas fa-sliders-h"></i><span>ثوابت النظام</span>
                    </a>
                }
                else
                {
                    <div class="nav-section-title">حركتي</div>
                    <a asp-controller="Manager" asp-action="Dashboard" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fas fa-home"></i><span>الرئيسية</span>
                    </a>
                    <div class="nav-section-title">الأعضاء</div>
                    <a asp-controller="Manager" asp-action="Members" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Members" ? "active" : "")">
                        <i class="fas fa-users"></i><span>الأعضاء</span>
                    </a>
                    <a asp-controller="Manager" asp-action="AddMember" class="nav-item">
                        <i class="fas fa-user-plus"></i><span>إضافة عضو</span>
                    </a>
                    <div class="nav-section-title">الطلبات</div>
                    <a asp-controller="Manager" asp-action="JoinRequests" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "JoinRequests" ? "active" : "")">
                        <i class="fas fa-inbox"></i><span>طلبات الانضمام</span>
                    </a>
                    <div class="nav-section-title">الإعدادات</div>
                    <a asp-controller="Manager" asp-action="Constants" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Constants" ? "active" : "")">
                        <i class="fas fa-sliders-h"></i><span>ثوابت الحركة</span>
                    </a>
                    <a asp-controller="Manager" asp-action="MovementInfo" class="nav-item">
                        <i class="fas fa-info-circle"></i><span>بيانات الحركة</span>
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-breadcrumb">
                    <span>@ViewData["Title"]</span>
                </div>
                <div class="navbar-user">
                    <div class="user-info">
                        <span class="user-name">@User.Identity?.Name</span>
                        <span class="user-role badge @(User.IsInRole("Admin") ? "badge-admin" : "badge-manager")">
                            @(User.IsInRole("Admin") ? "مدير النظام" : "مسؤول حركة")
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Alerts -->
            <div class="alerts-container">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>

            <!-- Page Content -->
            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="page-footer">
                <span>نظام إدارة الحركات &copy; @DateTime.Now.Year &mdash; ائتلاف دولة القانون</span>
                <span class="text-muted">تطوير: المهندس نبيل الخفاجي</span>
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('collapsed');
    document.querySelector('.main-content').classList.toggle('expanded');
}
// Auto-dismiss alerts after 5 seconds
setTimeout(() => {
    document.querySelectorAll('.alert').forEach(a => {
        const bsAlert = bootstrap.Alert.getOrCreateInstance(a);
        bsAlert.close();
    });
}, 5000);
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
