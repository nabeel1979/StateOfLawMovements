<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ائتلاف دولة القانون</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "authenticated" : "public-page")">

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo">
                    <img src="/images/logo.jpg" alt="ائتلاف دولة القانون"
                         style="width:52px;height:52px;object-fit:cover;border-radius:50%;border:2px solid rgba(255,255,255,.3)"/>
                </div>
                <div class="brand-text">
                    <span class="brand-main">ائتلاف دولة القانون</span>
                    <span class="brand-sub">نظام إدارة الحركات</span>
                </div>
            </div>

            <!-- زر إظهار/إخفاء الكل -->
            <div class="nav-toggle-all">
                <button id="toggleAllBtn" onclick="toggleAllGroups()" title="إظهار/إخفاء الكل">
                    <i class="fas fa-compress-alt" id="toggleAllIcon"></i>
                    <span id="toggleAllText">إخفاء الكل</span>
                </button>
            </div>

            <nav class="sidebar-nav">
                @{
                    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                    var act  = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                }
                @if (User.IsInRole("Admin"))
                {
                    <!-- لوحة التحكم -->
                    <a asp-controller="Admin" asp-action="Dashboard"
                       class="nav-item @(act == "Dashboard" && ctrl == "Admin" ? "active" : "")">
                        <i class="fas fa-chart-line"></i><span>لوحة التحكم</span>
                    </a>

                    <!-- مجموعة: الحركات -->
                    <div class="nav-group @(ctrl == "Admin" && (act == "Movements" || act == "CreateMovement" || act == "MovementDetails" || act == "MovementManagers") ? "open" : "open")" id="group-movements">
                        <button class="nav-group-header" onclick="toggleGroup('group-movements')">
                            <span><i class="fas fa-sitemap me-2"></i>الحركات</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Admin" asp-action="Movements"
                               class="nav-item nav-sub @(act == "Movements" ? "active" : "")">
                                <i class="fas fa-list"></i><span>قائمة الحركات</span>
                            </a>
                            <a asp-controller="Admin" asp-action="CreateMovement" class="nav-item nav-sub">
                                <i class="fas fa-plus-circle"></i><span>إنشاء حركة</span>
                            </a>
                        </div>
                    </div>

                    <!-- مجموعة: الأعضاء والطلبات -->
                    <div class="nav-group @(act == "Members" || act == "JoinRequests" || act == "MemberDetails" ? "open" : "open")" id="group-members">
                        <button class="nav-group-header" onclick="toggleGroup('group-members')">
                            <span><i class="fas fa-users me-2"></i>الأعضاء والطلبات</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Admin" asp-action="Members"
                               class="nav-item nav-sub @(act == "Members" ? "active" : "")">
                                <i class="fas fa-users"></i><span>الأعضاء</span>
                            </a>
                            <a asp-controller="Admin" asp-action="JoinRequests"
                               class="nav-item nav-sub @(act == "JoinRequests" ? "active" : "")">
                                <i class="fas fa-file-alt"></i><span>طلبات الانضمام</span>
                            </a>
                        </div>
                    </div>

                    <!-- مجموعة: التقارير -->
                    <div class="nav-group @(act == "Reports" || act == "AuditLogs" ? "open" : "open")" id="group-reports">
                        <button class="nav-group-header" onclick="toggleGroup('group-reports')">
                            <span><i class="fas fa-chart-bar me-2"></i>التقارير</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Admin" asp-action="Reports"
                               class="nav-item nav-sub @(act == "Reports" ? "active" : "")">
                                <i class="fas fa-chart-bar"></i><span>التقارير</span>
                            </a>
                            <a asp-controller="Admin" asp-action="AuditLogs"
                               class="nav-item nav-sub @(act == "AuditLogs" ? "active" : "")">
                                <i class="fas fa-history"></i><span>سجل العمليات</span>
                            </a>
                        </div>
                    </div>

                    <!-- مجموعة: الإعدادات -->
                    <div class="nav-group @(act == "SystemConstants" ? "open" : "open")" id="group-settings">
                        <button class="nav-group-header" onclick="toggleGroup('group-settings')">
                            <span><i class="fas fa-cog me-2"></i>الإعدادات</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Admin" asp-action="Users"
                               class="nav-item nav-sub @(act == "Users" || act == "CreateUser" || act == "EditUser" ? "active" : "")">
                                <i class="fas fa-users-cog"></i><span>مستخدمو النظام</span>
                            </a>
                            <a asp-controller="Admin" asp-action="SystemConstants"
                               class="nav-item nav-sub @(act == "SystemConstants" ? "active" : "")">
                                <i class="fas fa-sliders-h"></i><span>ثوابت النظام</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- الرئيسية -->
                    <a asp-controller="Manager" asp-action="Dashboard"
                       class="nav-item @(act == "Dashboard" ? "active" : "")">
                        <i class="fas fa-home"></i><span>الرئيسية</span>
                    </a>

                    <!-- مجموعة: الأعضاء -->
                    <div class="nav-group @(act == "Members" || act == "AddMember" || act == "EditMember" || act == "PrintMember" ? "open" : "open")" id="group-mgr-members">
                        <button class="nav-group-header" onclick="toggleGroup('group-mgr-members')">
                            <span><i class="fas fa-users me-2"></i>الأعضاء</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Manager" asp-action="Members"
                               class="nav-item nav-sub @(act == "Members" ? "active" : "")">
                                <i class="fas fa-users"></i><span>قائمة الأعضاء</span>
                            </a>
                            <a asp-controller="Manager" asp-action="AddMember" class="nav-item nav-sub">
                                <i class="fas fa-user-plus"></i><span>إضافة عضو</span>
                            </a>
                        </div>
                    </div>

                    <!-- مجموعة: طلبات الانضمام -->
                    <div class="nav-group @(act == "JoinRequests" || act == "RequestDetails" ? "open" : "open")" id="group-mgr-requests">
                        <button class="nav-group-header" onclick="toggleGroup('group-mgr-requests')">
                            <span><i class="fas fa-inbox me-2"></i>طلبات الانضمام</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Manager" asp-action="JoinRequests"
                               class="nav-item nav-sub @(act == "JoinRequests" ? "active" : "")">
                                <i class="fas fa-inbox"></i><span>قائمة الطلبات</span>
                            </a>
                        </div>
                    </div>

                    <!-- مجموعة: طلبات المواطنين -->
                    <div class="nav-group open" id="group-mgr-citizen">
                        <button class="nav-group-header" onclick="toggleGroup('group-mgr-citizen')">
                            <span><i class="fas fa-file-alt me-2"></i>طلبات المواطنين</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Manager" asp-action="CitizenRequests"
                               class="nav-item nav-sub @(act == "CitizenRequests" || act == "CitizenRequestDetails" ? "active" : "")">
                                <i class="fas fa-list"></i><span>جميع الطلبات</span>
                            </a>
                            <a asp-controller="Manager" asp-action="CreateCitizenRequest"
                               class="nav-item nav-sub @(act == "CreateCitizenRequest" ? "active" : "")">
                                <i class="fas fa-plus-circle"></i><span>إضافة طلب جديد</span>
                            </a>
                            <a asp-controller="Manager" asp-action="Destinations"
                               class="nav-item nav-sub @(act == "Destinations" ? "active" : "")">
                                <i class="fas fa-building"></i><span>الجهات</span>
                            </a>
                            <a asp-controller="Manager" asp-action="DocTypes"
                               class="nav-item nav-sub @(act == "DocTypes" ? "active" : "")">
                                <i class="fas fa-file-signature"></i><span>أنواع الوثائق</span>
                            </a>
                            <a asp-controller="Manager" asp-action="RequestStatuses"
                               class="nav-item nav-sub @(act == "RequestStatuses" ? "active" : "")">
                                <i class="fas fa-flag"></i><span>حالات الطلب</span>
                            </a>
                        </div>
                    </div>

                    <!-- مجموعة: الإعدادات -->
                    <div class="nav-group open" id="group-mgr-settings">
                        <button class="nav-group-header" onclick="toggleGroup('group-mgr-settings')">
                            <span><i class="fas fa-cog me-2"></i>الإعدادات</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-body">
                            <a asp-controller="Manager" asp-action="MovementInfo"
                               class="nav-item nav-sub @(act == "MovementInfo" ? "active" : "")">
                                <i class="fas fa-info-circle"></i><span>بيانات الحركة</span>
                            </a>
                        </div>
                    </div>
                }
            </nav>
        </aside>

        <!-- Overlay للموبايل -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebarMobile()"></div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-breadcrumb">
                    <span>@ViewData["Title"]</span>
                </div>
                <div class="navbar-user">
                    <div class="user-info">
                        <span class="user-name">@User.Identity?.Name</span>
                        <span class="user-role badge @(User.IsInRole("Admin") ? "badge-admin" : "badge-manager")">
                            @(User.IsInRole("Admin") ? "مدير النظام" : "مسؤول حركة")
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Alerts -->
            <div class="alerts-container">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>

            <!-- Page Content -->
            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="page-footer">
                <span>نظام إدارة الحركات &copy; @DateTime.Now.Year &mdash; ائتلاف دولة القانون</span>
                <span class="text-muted">المطور: المهندس نبيل الخفاجي</span>
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
function toggleSidebar() {
    const sidebar  = document.getElementById('sidebar');
    const overlay  = document.getElementById('sidebarOverlay');
    const isMobile = window.innerWidth <= 768;

    if (isMobile) {
        sidebar.classList.toggle('mobile-open');
        overlay.classList.toggle('active');
    } else {
        sidebar.classList.toggle('collapsed');
        document.querySelector('.main-content').classList.toggle('expanded');
    }
}

function closeSidebarMobile() {
    document.getElementById('sidebar').classList.remove('mobile-open');
    document.getElementById('sidebarOverlay').classList.remove('active');
}

// إغلاق السايدبار عند تغيير حجم الشاشة للكبير
window.addEventListener('resize', () => {
    if (window.innerWidth > 768) {
        document.getElementById('sidebar').classList.remove('mobile-open');
        document.getElementById('sidebarOverlay').classList.remove('active');
    }
});

// ── قوائم منسدلة ──────────────────────────────────────────────
function toggleGroup(id) {
    const group = document.getElementById(id);
    if (!group) return;
    group.classList.toggle('open');
    saveGroupState();
}

function toggleAllGroups() {
    const groups = document.querySelectorAll('.nav-group');
    const anyOpen = [...groups].some(g => g.classList.contains('open'));
    groups.forEach(g => anyOpen ? g.classList.remove('open') : g.classList.add('open'));
    updateToggleAllBtn(!anyOpen);
    saveGroupState();
}

function updateToggleAllBtn(allOpen) {
    const icon = document.getElementById('toggleAllIcon');
    const text = document.getElementById('toggleAllText');
    if (!icon || !text) return;
    if (allOpen) {
        icon.className = 'fas fa-compress-alt';
        text.textContent = 'إخفاء الكل';
    } else {
        icon.className = 'fas fa-expand-alt';
        text.textContent = 'إظهار الكل';
    }
}

function saveGroupState() {
    const state = {};
    document.querySelectorAll('.nav-group').forEach(g => {
        state[g.id] = g.classList.contains('open');
    });
    try { sessionStorage.setItem('navGroups', JSON.stringify(state)); } catch(e){}
    const anyOpen = [...document.querySelectorAll('.nav-group')].some(g => g.classList.contains('open'));
    updateToggleAllBtn(anyOpen);
}

// استعادة حالة القوائم عند التنقل
document.addEventListener('DOMContentLoaded', () => {
    try {
        const saved = JSON.parse(sessionStorage.getItem('navGroups') || '{}');
        document.querySelectorAll('.nav-group').forEach(g => {
            if (saved[g.id] === false) g.classList.remove('open');
            else g.classList.add('open'); // مفتوح افتراضياً
        });
    } catch(e) {
        document.querySelectorAll('.nav-group').forEach(g => g.classList.add('open'));
    }
    updateToggleAllBtn([...document.querySelectorAll('.nav-group')].some(g => g.classList.contains('open')));
});

// Auto-dismiss alerts after 5 seconds
setTimeout(() => {
    document.querySelectorAll('.alert').forEach(a => {
        const bsAlert = bootstrap.Alert.getOrCreateInstance(a);
        bsAlert.close();
    });
}, 5000);
</script>
@await RenderSectionAsync("Scripts", required: false)

<!-- Global Custom Confirm Modal -->
<div id="gConfirmOverlay" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.55);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;width:90%;max-width:400px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.25);">
        <div id="gConfirmHeader" style="padding:1.2rem 1.5rem;display:flex;align-items:center;gap:.85rem;">
            <div id="gConfirmIconWrap" style="width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;background:rgba(255,255,255,.22);">
                <span id="gConfirmIcon"></span>
            </div>
            <div>
                <div id="gConfirmTitle" style="font-weight:700;font-size:1rem;color:#fff;font-family:'Cairo',sans-serif;"></div>
                <div id="gConfirmMsg" style="font-size:.85rem;color:rgba(255,255,255,.88);font-family:'Cairo',sans-serif;margin-top:2px;"></div>
            </div>
        </div>
        <div style="padding:1rem 1.5rem 1.25rem;display:flex;gap:.75rem;justify-content:flex-start;background:#fafafa;">
            <button id="gConfirmOkBtn" style="border:none;border-radius:8px;padding:.55rem 1.5rem;font-family:'Cairo',sans-serif;font-size:.95rem;font-weight:700;cursor:pointer;color:#fff;transition:opacity .15s;" onmouseover="this.style.opacity='.88'" onmouseout="this.style.opacity='1'">تأكيد</button>
            <button onclick="gCloseConfirm()" style="background:#e2e8f0;color:#475569;border:none;border-radius:8px;padding:.55rem 1.5rem;font-family:'Cairo',sans-serif;font-size:.95rem;font-weight:600;cursor:pointer;">إلغاء</button>
        </div>
    </div>
</div>
<style>
    #gConfirmOverlay { animation: none; }
    @@keyframes gFadeIn { from{opacity:0;transform:scale(.94)} to{opacity:1;transform:scale(1)} }
    #gConfirmOverlay > div { animation: gFadeIn .18s ease; }
</style>
<script>
var _gConfirmResolve = null;
function gConfirm(msg, type) {
    type = type || 'default';
    var cfg = {
        success : { bg:'#1a5c38', icon:'<i class="fas fa-check-circle"></i>', title:'تأكيد العملية' },
        danger  : { bg:'#dc2626', icon:'<i class="fas fa-exclamation-triangle"></i>', title:'تأكيد الحذف' },
        warning : { bg:'#d97706', icon:'<i class="fas fa-question-circle"></i>', title:'تأكيد العملية' },
        default : { bg:'#1a5c38', icon:'<i class="fas fa-question-circle"></i>', title:'تأكيد العملية' }
    };
    var c = cfg[type] || cfg.default;
    document.getElementById('gConfirmHeader').style.background = c.bg;
    document.getElementById('gConfirmIcon').innerHTML = c.icon;
    document.getElementById('gConfirmTitle').innerText = c.title;
    document.getElementById('gConfirmMsg').innerText = msg;
    document.getElementById('gConfirmOkBtn').style.background = c.bg;
    document.getElementById('gConfirmOverlay').style.display = 'flex';
    return new Promise(function(resolve){ _gConfirmResolve = resolve; });
}
function gCloseConfirm(result) {
    document.getElementById('gConfirmOverlay').style.display = 'none';
    if (_gConfirmResolve) { _gConfirmResolve(!!result); _gConfirmResolve = null; }
}
document.getElementById('gConfirmOkBtn').addEventListener('click', function(){ gCloseConfirm(true); });
document.getElementById('gConfirmOverlay').addEventListener('click', function(e){ if(e.target===this) gCloseConfirm(false); });

// تجاوز window.confirm العادي للنماذج inline
document.addEventListener('submit', function(e){
    var frm = e.target;
    var msg = frm.getAttribute('data-confirm');
    var type = frm.getAttribute('data-confirm-type') || 'danger';
    if(msg){
        e.preventDefault();
        gConfirm(msg, type).then(function(ok){ if(ok) frm.submit(); });
    }
}, true);

// onclick confirm override
window.__origConfirm = window.confirm;
window.confirm = function(msg) {
    // للأزرار التي تستخدم onclick="return confirm(...)" — نعيد true مؤقتاً ونُظهر الـ modal بدلاً
    return window.__origConfirm(msg);
};
</script>

<!-- عارض الصور: أي صورة تحمل data-zoom تُفتح مكبّرة -->
<div id="imgViewer" class="img-viewer" role="dialog" aria-modal="true" aria-label="عرض الصورة">
    <div class="img-viewer-bar">
        <span id="imgViewerCaption" class="img-viewer-caption"></span>
        <div class="img-viewer-tools">
            <button type="button" id="imgViewerZoomOut" title="تصغير"><i class="fas fa-search-minus"></i></button>
            <span id="imgViewerLevel">100%</span>
            <button type="button" id="imgViewerZoomIn" title="تكبير"><i class="fas fa-search-plus"></i></button>
            <a id="imgViewerOpen" href="#" target="_blank" title="فتح في تبويب جديد"><i class="fas fa-external-link-alt"></i></a>
            <a id="imgViewerDownload" href="#" download title="تنزيل"><i class="fas fa-download"></i></a>
            <button type="button" id="imgViewerClose" title="إغلاق"><i class="fas fa-times"></i></button>
        </div>
    </div>
    <div class="img-viewer-stage" id="imgViewerStage">
        <img id="imgViewerImg" alt=""/>
    </div>
</div>
<script>
(function () {
    var viewer  = document.getElementById('imgViewer');
    var stage   = document.getElementById('imgViewerStage');
    var img     = document.getElementById('imgViewerImg');
    var caption = document.getElementById('imgViewerCaption');
    var level   = document.getElementById('imgViewerLevel');
    var openTab = document.getElementById('imgViewerOpen');
    var dl      = document.getElementById('imgViewerDownload');
    var zoom    = 1;

    var STEPS = [0.5, 0.75, 1, 1.5, 2, 3, 4];

    function apply() {
        img.style.transform = 'scale(' + zoom + ')';
        level.textContent = Math.round(zoom * 100) + '%';
        stage.classList.toggle('zoomed', zoom > 1);
    }

    function step(dir) {
        var i = STEPS.indexOf(zoom);
        if (i === -1) i = STEPS.indexOf(1);
        i = Math.min(STEPS.length - 1, Math.max(0, i + dir));
        zoom = STEPS[i];
        apply();
    }

    function open(src, text) {
        img.src = src;
        img.alt = text || '';
        caption.textContent = text || '';
        openTab.href = src;
        dl.href = src;
        zoom = 1;
        apply();
        viewer.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        viewer.classList.remove('open');
        document.body.style.overflow = '';
        img.removeAttribute('src');
    }

    document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-zoom]');
        if (trigger) {
            e.preventDefault();
            open(trigger.getAttribute('data-zoom') || trigger.getAttribute('src'),
                 trigger.getAttribute('data-zoom-title'));
        }
    });

    document.getElementById('imgViewerClose').addEventListener('click', close);
    document.getElementById('imgViewerZoomIn').addEventListener('click', function () { step(1); });
    document.getElementById('imgViewerZoomOut').addEventListener('click', function () { step(-1); });

    // النقر على الخلفية يغلق، والنقر على الصورة نفسها يبدّل التكبير
    stage.addEventListener('click', function (e) {
        if (e.target === img) { step(zoom >= 2 ? -1 : 1); return; }
        close();
    });

    document.addEventListener('keydown', function (e) {
        if (!viewer.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === '+' || e.key === '=') step(1);
        else if (e.key === '-') step(-1);
    });

    stage.addEventListener('wheel', function (e) {
        if (!viewer.classList.contains('open')) return;
        e.preventDefault();
        step(e.deltaY < 0 ? 1 : -1);
    }, { passive: false });
})();
</script>
</body>
</html>
